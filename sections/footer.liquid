<footer class="clean-footer">
  <div class="footer-inner">

    <!-- Brand Column -->
    <div class="footer-col">
      {% if section.settings.logo != blank %}
        <img 
          src="{{ section.settings.logo | img_url: '300x' }}" 
          alt="{{ shop.name }}" 
          class="footer-logo"
        >
      {% else %}
        <h2 class="footer-title">{{ shop.name }}</h2>
      {% endif %}

      <p class="footer-text">
        {{ section.settings.about }}
      </p>
    </div>

    <!-- Menu Column -->
    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        {% for link in linklists[section.settings.menu].links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <!-- Contact Column -->
    <div class="footer-col">
      <h4>Contact</h4>
      <p>{{ section.settings.email }}</p>
      <p>{{ section.settings.phone }}</p>
      <p>{{ section.settings.address }}</p>

      <div class="footer-social">
        {% if section.settings.facebook != blank %}
          <a href="{{ section.settings.facebook }}" target="_blank">Facebook</a>
        {% endif %}
        {% if section.settings.instagram != blank %}
          <a href="{{ section.settings.instagram }}" target="_blank">Instagram</a>
        {% endif %}
        {% if section.settings.tiktok != blank %}
          <a href="{{ section.settings.tiktok }}" target="_blank">TikTok</a>
        {% endif %}
      </div>
    </div>

  </div>

  <div class="footer-bottom">
    © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
  </div>
</footer>

<style>
.clean-footer{
  background:#111;
  color:#eee;
  padding:60px 20px 20px;
}

.footer-inner{
  max-width:1200px;
  margin:auto;
  display:flex;
  flex-wrap:wrap;
  gap:40px;
}

.footer-col{
  flex:1;
  min-width:250px;
}

.footer-logo{
  max-height:60px;
  margin-bottom:15px;
}

.footer-title{
  margin-bottom:15px;
}

.footer-text{
  color:#aaa;
  font-size:14px;
  line-height:1.6;
}

.footer-col h4{
  margin-bottom:15px;
}

.footer-col ul{
  list-style:none;
  padding:0;
}

.footer-col li{
  margin-bottom:8px;
}

.footer-col a{
  color:#bbb;
  text-decoration:none;
  font-size:14px;
}

.footer-col a:hover{
  color:#fff;
}

.footer-social{
  margin-top:15px;
  display:flex;
  gap:15px;
}

.footer-bottom{
  text-align:center;
  margin-top:40px;
  padding-top:20px;
  border-top:1px solid #333;
  font-size:13px;
  color:#888;
}

@media(max-width:768px){
  .footer-inner{
    flex-direction:column;
  }
}
</style>

{% schema %}
{
  "name": "Clean Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "About text",
      "default": "Write something about your brand."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook link"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok link"
    }
  ],
  "presets": [
    {
      "name": "Clean Footer"
    }
  ]
}
{% endschema %}
