<footer class="clean-footer">
  <div class="footer-inner">

    <!-- Brand Column -->
    <div class="footer-col">
      {% if section.settings.logo != blank %}
        <img 
          src="{{ section.settings.logo | img_url: '300x' }}" 
          alt="{{ shop.name }}" 
          class="footer-logo"
        >
      {% else %}
        <h2 class="footer-title">{{ shop.name }}</h2>
      {% endif %}

      <p class="footer-text">
        {{ section.settings.about }}
      </p>
    </div>

    <!-- Menu Column -->
    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        {% for link in linklists[section.settings.menu].links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

<!-- CONTACT COLUMN -->
<div class="footer-col">

  <h4>Contact</h4>

  {% if section.settings.email != blank %}
    <p>{{ section.settings.email }}</p>
  {% endif %}

  {% if section.settings.phone != blank %}
    <p>{{ section.settings.phone }}</p>
  {% endif %}

  {% if section.settings.address != blank %}
    <p>{{ section.settings.address }}</p>
  {% endif %}

  <!-- SOCIAL ICONS -->
  <div class="footer-social">

    <!-- FACEBOOK -->
    {% if shop.brand.metafields.social_links.facebook.value != blank %}
      <a href="{{ shop.brand.metafields.social_links.facebook.value }}" target="_blank" aria-label="Facebook">

        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.88 3.78-3.88 1.1 0 2.24.2 2.24.2v2.46H15.2c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/>
        </svg>

      </a>
    {% endif %}

    <!-- INSTAGRAM -->
    {% if shop.brand.metafields.social_links.instagram.value != blank %}
      <a href="{{ shop.brand.metafields.social_links.instagram.value }}" target="_blank" aria-label="Instagram">

        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm10 2c1.7 0 3 1.3 3 3v10c0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3V7c0-1.7 1.3-3 3-3h10zm-5 3.5A5.5 5.5 0 1 0 17.5 13 5.5 5.5 0 0 0 12 7.5zm0 2A3.5 3.5 0 1 1 8.5 13 3.5 3.5 0 0 1 12 9.5zm4.8-3.3a1.3 1.3 0 1 0 1.3 1.3 1.3 1.3 0 0 0-1.3-1.3z"/>
        </svg>

      </a>
    {% endif %}

    <!-- TIKTOK -->
    {% if shop.brand.metafields.social_links.tiktok.value != blank %}
      <a href="{{ shop.brand.metafields.social_links.tiktok.value }}" target="_blank" aria-label="TikTok">

        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 7.8a5.7 5.7 0 0 1-3.3-1V15a5 5 0 1 1-5-5h.4v2.6h-.4a2.4 2.4 0 1 0 2.4 2.4V2h2.6a3.2 3.2 0 0 0 3.3 3.2z"/>
        </svg>

      </a>
    {% endif %}

    <!-- YOUTUBE -->
    {% if shop.brand.metafields.social_links.youtube.value != blank %}
      <a href="{{ shop.brand.metafields.social_links.youtube.value }}" target="_blank" aria-label="YouTube">

        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.8zM9.6 15.5v-7L15.8 12l-6.2 3.5z"/>
        </svg>

      </a>
    {% endif %}

  </div>

</div>

  </div>

  <div class="footer-bottom">
    © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
  </div>
</footer>

<style>
  .footer-social{
  display:flex;
  gap:14px;
  margin-top:15px;
}

.footer-social a{
  display:flex;
  align-items:center;
  justify-content:center;

  color: {{ shop.brand.colors.secondary[0].background }};
  transition:0.3s ease;
}

.footer-social a:hover{
  color: {{ shop.brand.colors.primary[0].background }};
  transform:translateY(-2px);
}

.footer-social svg{
  width:22px;
  height:22px;
}
.clean-footer{
  background:#111;
  color:#eee;
  padding:60px 20px 20px;
}

.footer-inner{
  max-width:1200px;
  margin:auto;
  display:flex;
  flex-wrap:wrap;
  gap:40px;
}

.footer-col{
  flex:1;
  min-width:250px;
}

.footer-logo{
  max-height:60px;
  margin-bottom:15px;
}

.footer-title{
  margin-bottom:15px;
}

.footer-text{
  color:#aaa;
  font-size:14px;
  line-height:1.6;
}

.footer-col h4{
  margin-bottom:15px;
}

.footer-col ul{
  list-style:none;
  padding:0;
}

.footer-col li{
  margin-bottom:8px;
}

.footer-col a{
  color:#bbb;
  text-decoration:none;
  font-size:14px;
}

.footer-col a:hover{
  color:#fff;
}

.footer-social{
  margin-top:15px;
  display:flex;
  gap:15px;
}

.footer-bottom{
  text-align:center;
  margin-top:40px;
  padding-top:20px;
  border-top:1px solid #333;
  font-size:13px;
  color:#888;
}

@media(max-width:768px){
  .footer-inner{
    flex-direction:column;
  }
}
</style>

{% schema %}
{
  "name": "Clean Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "About text",
      "default": "Write something about your brand."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook link"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok link"
    }
  ],
  "presets": [
    {
      "name": "Clean Footer"
    }
  ]
}
{% endschema %}
