<section class="thank-you">
  <div class="page-width">
    <div class="thank-you__card">

      <div class="thank-you__icon">✓</div>

      <h1>{{ section.settings.heading }}</h1>

      <p class="thank-you__subtitle">
        {{ section.settings.subtitle }}
      </p>

      <div class="thank-you__message">
        {{ section.settings.message }}
      </div>

      <div class="thank-you__phones">
        {% if section.settings.phone_1 != blank %}
          <a href="tel:{{ section.settings.phone_1 }}">
            📞 {{ section.settings.phone_1 }}
          </a>
        {% endif %}

        {% if section.settings.phone_2 != blank %}
          <a href="tel:{{ section.settings.phone_2 }}">
            📞 {{ section.settings.phone_2 }}
          </a>
        {% endif %}
      </div>

      <p class="thank-you__note">
        {{ section.settings.note }}
      </p>

      <a class="button" href="{{ routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>

    </div>
  </div>
</section>

<style>
.thank-you{
  padding:80px 20px;
  background:#f8f8f8;
}

.thank-you__card{
  max-width:650px;
  margin:auto;
  background:#fff;
  padding:50px 35px;
  border-radius:16px;
  text-align:center;
  box-shadow:0 8px 30px rgba(0,0,0,.08);
}

.thank-you__icon{
  width:70px;
  height:70px;
  margin:0 auto 20px;
  border-radius:50%;
  background:#16a34a;
  color:#fff;
  font-size:38px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:700;
}

.thank-you h1{
  margin:0 0 12px;
  font-size:34px;
}

.thank-you__subtitle{
  font-size:18px;
  font-weight:600;
  margin-bottom:24px;
}

.thank-you__message{
  line-height:1.8;
  margin-bottom:24px;
}

.thank-you__phones{
  display:flex;
  flex-direction:column;
  gap:12px;
  margin:30px 0;
}

.thank-you__phones a{
  text-decoration:none;
  color:#111;
  font-size:18px;
  font-weight:700;
}

.thank-you__note{
  color:#555;
  margin-bottom:35px;
  line-height:1.8;
}

.button{
  display:inline-block;
  padding:14px 30px;
  background:#111;
  color:#fff;
  text-decoration:none;
  border-radius:8px;
  font-weight:600;
}

.button:hover{
  opacity:.9;
}
</style>

{% schema %}
{
  "name": "Thank You Message",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "✅ Merci pour votre commande !"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "سيتم الاتصال بك قريبًا لتأكيد الطلب."
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p><strong>سيكون الاتصال من أحد الأرقام التالية:</strong></p>"
    },
    {
      "type": "text",
      "id": "phone_1",
      "label": "Phone Number 1",
      "default": "+213 XX XX XX XX XX"
    },
    {
      "type": "text",
      "id": "phone_2",
      "label": "Phone Number 2",
      "default": "+213 YY YY YY YY YY"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Confirmation Note",
      "default": "يرجى الرد على المكالمة حتى نتمكن من تأكيد طلبكم وتجهيزه للشحن في أقرب وقت."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Continue Shopping"
    }
  ],
  "presets": [
    {
      "name": "Thank You Message"
    }
  ]
}
{% endschema %}