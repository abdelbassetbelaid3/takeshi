<section class="home-products">
  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {% endif %}

    {% assign products = collections[section.settings.collection].products | limit: section.settings.limit %}
    {% if products.size > 0 %}
      <div class="products-grid">
        {% for product in products %}
          <div class="product-card">
            <a href="{{ product.url }}">
              <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}">
            </a>
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <span class="price">{{ product.price | money }}</span>
            <form action="/cart/add" method="post" enctype="multipart/form-data">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="btn">Add to Cart</button>
            </form>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p>No products found in this collection.</p>
    {% endif %}
  </div>
</section>

<style>
.home-products{
  padding:60px 20px;
  background:#f9f9f9;
}

.section-title{
  text-align:center;
  font-size:28px;
  margin-bottom:40px;
}

.products-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px,1fr));
  gap:30px;
}

.product-card{
  background:#fff;
  padding:15px;
  border-radius:10px;
  text-align:center;
  transition:0.3s;
}

.product-card:hover{
  box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

.product-card img{
  width:100%;
  height:300px;
  object-fit:cover;
  margin-bottom:15px;
  border-radius:8px;
}

.product-card h3{
  font-size:16px;
  margin-bottom:10px;
}

.price{
  font-weight:bold;
  display:block;
  margin-bottom:15px;
}

.btn{
  background:#111;
  color:#fff;
  border:none;
  padding:10px 15px;
  border-radius:5px;
  cursor:pointer;
  transition:0.3s;
}

.btn:hover{
  background:#333;
}
</style>

{% schema %}
{
  "name": "Homepage Product List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Number of products to show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Homepage Product List"
    }
  ]
}
{% endschema %}
