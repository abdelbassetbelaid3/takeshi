<header class="site-header">

  <!-- LEFT: Hamburger -->
  <button class="header__menu-btn" id="menu-toggle" aria-label="Open menu">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <!-- CENTER: Logo -->

<div class="header-logo">
  <a href="{{ routes.root_url }}">

    {% if shop.brand.logo != blank %}
      <img
        src="{{ shop.brand.logo | image_url: width: 100 }}"
        alt="{{ shop.name }}"
        loading="lazy"
      >
    {% else %}
      {{ shop.name }}
    {% endif %}

  </a>
</div>
  <!-- RIGHT: Icons -->
  <div class="header__icons">
<button class="header__icon" id="search-toggle" aria-label="Search">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
    <circle cx="11" cy="11" r="7" stroke="black" stroke-width="2"/>
    <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="black" stroke-width="2"/>
  </svg>
</button>

<div class="search-overlay" id="search-overlay">

  <div class="search-box">
    
    <button class="search-close" id="search-close">✕</button>

    <form action="{{ routes.search_url }}" method="get">
      <input 
        type="search" 
        name="q" 
        placeholder="Search products..."
        autofocus
      >
    </form>

  </div>

</div>

    <button class="header__icon" id="cart-toggle">
      {% if cart.item_count > 0 %}
        <sup class="cart-count">{{ cart.item_count }}</sup>
      {% endif %}
       <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
    <path d="M6 6h15l-1.5 9h-13L5 4H2" stroke="black" stroke-width="2" stroke-linecap="round"/>
    <circle cx="9" cy="20" r="1.5" fill="black"/>
    <circle cx="18" cy="20" r="1.5" fill="black"/>
  </svg>
    </button>
  </div>

</header>

<!-- LEFT MENU DRAWER -->
<div class="menu-drawer" id="menu-drawer">
  <div class="drawer-header">
    <button id="menu-close">✕</button>
  </div>

  <nav class="drawer-nav">
    {% if section.settings.menu %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    {% endif %}
  </nav>
</div>

<!-- RIGHT CART DRAWER -->
<div class="cart-drawer" id="cart-drawer">
  <div class="drawer-header">
    <h3>Your Cart</h3>
    <button id="cart-close">✕</button>
  </div>

  <div class="drawer-content">
    {% if cart.item_count == 0 %}
      <p>Your cart is empty</p>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-item">
          <img src="{{ item.image | image_url: width: 80 }}">
          <div>
            <p>{{ item.product.title }}</p>
            <p>{{ item.quantity }} × {{ item.price | money }}</p>
          </div>
        </div>
      {% endfor %}
      <a href="{{ routes.cart_url }}" class="drawer-checkout">
        View Cart
      </a>
    {% endif %}
  </div>
</div>

<!-- OVERLAY -->
<div class="drawer-overlay" id="drawer-overlay"></div>

{% stylesheet %}
.search-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,0.6);
  display:flex;
  align-items:center;
  justify-content:center;
  opacity:0;
  visibility:hidden;
  transition:0.3s;
  z-index:9999;
}

.search-overlay.open{
  opacity:1;
  visibility:visible;
}

.search-box{
  background:#fff;
  padding:30px;
  width:90%;
  max-width:500px;
  position:relative;
}

.search-box input{
  width:100%;
  padding:15px;
  font-size:16px;
  border:1px solid #ddd;
}

.search-close{
  position:absolute;
  top:10px;
  right:10px;
  background:none;
  border:none;
  font-size:20px;
  cursor:pointer;
}
.site-header {
  height: 70px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 10%;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid #eee;
}

/* Hamburger */
.header__menu-btn {
  justify-self: start;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.header__menu-btn span {
  width: 22px;
  height: 2px;
  background: #000;
}

/* Logo */
.header__logo {
  justify-self: center;
}
.header__logo img {
  max-height: 50px;
  width: auto;
}

/* Icons */
.header__icons {
  justify-self: end;
  display: flex;
  gap: 16px;
}
.header__icon {
  position: relative;
  background: none;
  border: none;
  cursor: pointer;
}
.cart-count {
  position: absolute;
  top: -6px;
  right: -8px;
  font-size: 11px;
}

/* DRAWERS */
.menu-drawer,
.cart-drawer {
  position: fixed;
  top: 0;
  width: 320px;
  height: 100%;
  background: #fff;
  z-index: 100;
  transition: 0.3s ease;
  padding: 20px;
  overflow-y: auto;
}

.menu-drawer { left: -320px; }
.cart-drawer { right: -320px; }

.menu-drawer.open { left: 0; }
.cart-drawer.open { right: 0; }

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-nav {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 20px;
}
.drawer-nav a {
  text-decoration: none;
  color: #000;
}

.cart-item {
  display: flex;
  gap: 10px;
  margin: 15px 0;
}

.drawer-checkout {
  display: block;
  margin-top: 20px;
  padding: 12px;
  text-align: center;
  background: #000;
  color: #fff;
  text-decoration: none;
}

/* Overlay */
.drawer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  opacity: 0;
  visibility: hidden;
  transition: 0.3s;
  z-index: 90;
}
.drawer-overlay.show {
  opacity: 1;
  visibility: visible;
}
{% endstylesheet %}
<script>
document.addEventListener("DOMContentLoaded", function(){

  const openBtn = document.getElementById("search-toggle");
  const overlay = document.getElementById("search-overlay");
  const closeBtn = document.getElementById("search-close");

  if (!openBtn || !overlay) return;

  openBtn.addEventListener("click", () => {
    overlay.classList.add("open");
    document.body.style.overflow = "hidden";
  });

  closeBtn.addEventListener("click", closeSearch);
  overlay.addEventListener("click", function(e){
    if(e.target === overlay) closeSearch();
  });

  function closeSearch(){
    overlay.classList.remove("open");
    document.body.style.overflow = "";
  }

});
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {

  const overlay = document.getElementById('drawer-overlay');

  // MENU
  const menu = document.getElementById('menu-drawer');
  const menuOpen = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');

  menuOpen.addEventListener('click', function() {
    menu.classList.add('open');
    overlay.classList.add('show');
  });

  menuClose.addEventListener('click', closeAll);

  // CART
  const cart = document.getElementById('cart-drawer');
  const cartOpen = document.getElementById('cart-toggle');
  const cartClose = document.getElementById('cart-close');

  cartOpen.addEventListener('click', function() {
    cart.classList.add('open');
    overlay.classList.add('show');
  });

  cartClose.addEventListener('click', closeAll);
  overlay.addEventListener('click', closeAll);

  function closeAll() {
    menu.classList.remove('open');
    cart.classList.remove('open');
    overlay.classList.remove('show');
  }

});
</script>

{% schema %}
{
  "name": "Centered Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ],
  "presets": [
    {
      "name": "Centered Header"
    }
  ]
}
{% endschema %}
