<div class="product-page">

  {% for block in section.blocks %}

    {% case block.type %}

      {% when 'product-media' %}
        <div class="product-page__media" {{ block.shopify_attributes }}>
          {% render 'product-media-slider', product: product %}
        </div>

      {% when 'product-details' %}
        <div class="product-page__details" {{ block.shopify_attributes }}>
          {% render 'product-details', product: product %}
        </div>

    {% endcase %}

  {% endfor %}

</div>