{% comment %}
  Search template
{% endcomment %}

<div class="search-page">

  <!-- SEARCH FORM -->
  <form action="{{ routes.search_url }}" method="get" class="search-form">

    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="Search products..."
      class="search-input"
    >

    <button type="submit" class="search-button">
      Search
    </button>

  </form>


  <!-- RESULTS TITLE -->
  {% if search.performed %}
    <h1 class="search-title">
      Results for "{{ search.terms }}"
    </h1>
  {% endif %}


  <!-- PRODUCTS GRID -->
  <div class="search-products">

    {% paginate search.results by 20 %}

      {% for item in search.results %}

        {% if item.object_type == 'product' %}

          <div class="search-product">

            <a href="{{ item.url }}" class="search-product__image-wrapper">

              {% if item.featured_image %}

                <!-- MAIN IMAGE -->
                <img
                  class="search-product__image main-img"
                  src="{{ item.featured_image | image_url: width: 900 }}"
                  alt="{{ item.title }}"
                  loading="lazy"
                >

                <!-- SECOND IMAGE -->
                {% if item.images[1] %}
                  <img
                    class="search-product__image hover-img"
                    src="{{ item.images[1] | image_url: width: 900 }}"
                    alt="{{ item.title }}"
                    loading="lazy"
                  >
                {% endif %}

              {% else %}

                <!-- PLACEHOLDER -->
                <div class="search-product__placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>

              {% endif %}

            </a>


            <!-- INFO -->
            <div class="search-product__content">

              <p class="search-product__title">
                {{ item.title | escape | link_to: item.url }}
              </p>

              <p class="search-product__price">
                {{ item.price | money }}
              </p>

            </div>

          </div>

        {% endif %}

      {% endfor %}

      {{ paginate | default_pagination }}

    {% endpaginate %}

  </div>

</div>


{% stylesheet %}

/* =========================
   PAGE
========================= */

.search-page{
  margin: 40px 5%;
}


/* =========================
   SEARCH FORM
========================= */

.search-form{
  display: flex;
  gap: 10px;

  margin-bottom: 40px;
}

.search-input{
  flex: 1;

  height: 50px;

  border: 1px solid #ddd;

  padding-inline: 15px;

  font-size: 16px;
}

.search-button{
  height: 50px;

  border: none;

  background: #000;

  color: #fff;

  padding-inline: 24px;

  cursor: pointer;
}


/* =========================
   TITLE
========================= */

.search-title{
  margin-bottom: 30px;

  font-size: 28px;
}


/* =========================
   GRID
========================= */

.search-products{
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;
}


/* =========================
   CARD
========================= */

.search-product{
  width: 100%;
}


/* =========================
   IMAGE WRAPPER
========================= */

.search-product__image-wrapper{
  position: relative;

  display: block;

  overflow: hidden;
}


/* =========================
   IMAGES
========================= */

.search-product__image{
  width: 100%;

  aspect-ratio: 2 / 3;

  object-fit: cover;

  display: block;

  transition: 0.45s ease;
}


/* =========================
   HOVER IMAGE
========================= */

.hover-img{
  position: absolute;

  inset: 0;

  opacity: 0;
}


/* =========================
   HOVER EFFECT
========================= */

.search-product__image-wrapper:hover .main-img{
  opacity: 0;

  transform: scale(1.06);
}

.search-product__image-wrapper:hover .hover-img{
  opacity: 1;

  transform: scale(1.06);
}


/* =========================
   PLACEHOLDER
========================= */

.search-product__placeholder{
  width: 100%;

  aspect-ratio: 2 / 3;

  background: #f5f5f5;

  display: flex;
  align-items: center;
  justify-content: center;
}

.search-product__placeholder svg{
  width: 50%;
  height: 50%;

  opacity: 0.3;
}


/* =========================
   CONTENT
========================= */

.search-product__content{
  padding-top: 12px;
}

.search-product__title{
  margin: 0 0 6px;

  font-size: 16px;
}

.search-product__title a{
  text-decoration: none;

  color: #000;
}

.search-product__price{
  margin: 0;

  font-weight: 600;
}


/* =========================
   TABLET
========================= */

@media (max-width: 900px){

  .search-products{
    grid-template-columns: repeat(2, 1fr);
  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 600px){

  .search-page{
    margin: 20px 15px;
  }

  .search-products{
    grid-template-columns: 1fr;

    gap: 15px;
  }

  .search-form{
    flex-direction: column;
  }

  .search-button{
    width: 100%;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}