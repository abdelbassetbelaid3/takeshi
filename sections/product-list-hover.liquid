<section class="pl-section">
  <div class="pl-container">

    {% if section.settings.title != blank %}
      <h2 class="pl-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="pl-grid">
      {% for block in section.blocks %}
        {% assign p = block.settings.product %}

        {% if p %}
          <div class="pl-card" {{ block.shopify_attributes }}>

            <a href="{{ p.url }}" class="pl-image">

              {% if p.featured_image %}
                <img
                  src="{{ p.featured_image | image_url: width: 600 }}"
                  class="pl-main"
                  alt="{{ p.title }}"
                  loading="lazy"
                >
              {% endif %}

              {% if p.images[1] %}
                <img
                  src="{{ p.images[1] | image_url: width: 600 }}"
                  class="pl-hover"
                  alt="{{ p.title }}"
                  loading="lazy"
                >
              {% endif %}

            </a>

            <div class="pl-info">
              <h3>{{ p.title }}</h3>
              <span class="pl-price">{{ p.price | money }}</span>
            </div>

          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
.pl-section{
  padding:60px 20px;
}

.pl-title{
  text-align:center;
  font-size:28px;
  margin-bottom:30px;
}

/* GRID */
.pl-grid{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:20px;
}

/* responsive */
@media(max-width:1000px){
  .pl-grid{ grid-template-columns: repeat(3,1fr); }
}
@media(max-width:700px){
  .pl-grid{ grid-template-columns: repeat(2,1fr); }
}
@media(max-width:480px){
  .pl-grid{ grid-template-columns: 1fr; }
}

/* IMAGE */
.pl-image{
  position:relative;
  display:block;
  overflow:hidden;
}

.pl-image img{
  width:100%;
  height:260px;
  object-fit:cover;
  transition:0.4s ease;
}

/* hover setup */
.pl-hover{
  position:absolute;
  top:0;
  left:0;
  opacity:0;
}

/* hover effect */
.pl-image:hover .pl-main{
  opacity:0;
  transform:scale(1.08);
}

.pl-image:hover .pl-hover{
  opacity:1;
  transform:scale(1.08);
}

/* INFO */
.pl-info{
  text-align:center;
  padding:10px 0;
}

.pl-price{
  font-weight:bold;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product List Hover",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Products"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Product List Hover",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}