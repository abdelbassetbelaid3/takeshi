<section class="product-page-slider">
  <div class="container">
    <div class="product-grid">

      <!-- IMAGE SLIDER -->
      <div class="product-images">
        {% assign images_to_show = product.images | slice: 0,6 %}
        {% if images_to_show.size > 0 %}
          <div class="slider-wrapper">
            <button class="arrow left" onclick="slideImages(-1)">‹</button>

            <div class="image-slider" id="imageSlider">
              {% for image in images_to_show %}
                <div class="slide">
                  <img src="{{ image | img_url: '800x' }}" alt="{{ product.title }}">
                </div>
              {% endfor %}
            </div>
              <p>gfdghbdjk</p>
            <button class="arrow right" onclick="slideImages(1)">›</button>
          </div>

          <!-- THUMBNAILS -->
          <div class="thumbs">
            {% for image in images_to_show %}
              <img src="{{ image | img_url: '200x200' }}" class="thumb" onclick="goToSlide({{ forloop.index0 }})">
            {% endfor %}
          </div>

          <!-- DOTS NAVIGATION -->
          <div class="dots" id="dotsNav">
            {% for image in images_to_show %}
              <span class="dot" onclick="goToSlide({{ forloop.index0 }})"></span>
            {% endfor %}
          </div>

        {% else %}
          <div class="no-image">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <!-- PRODUCT INFO -->
      <div class="product-info">
        <h1>{{ product.title }}</h1>

        <div class="price">{{ product.price | money }}</div>

        {% if product.variants.size > 1 %}
          <label>Variant</label>
          <select name="id" form="product-form">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money }}</option>
            {% endfor %}
          </select>
        {% endif %}

        <form method="post" action="/cart/add" id="product-form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <div class="qty-row">
            <label>Qty</label>
            <input type="number" name="quantity" value="1" min="1">
          </div>
          <button type="submit" class="add-cart">Add to cart</button>
        </form>

        <div class="description">{{ product.description }}</div>
      </div>

    </div>
  </div>
</section>

<style>
.product-page-slider{
  padding:60px 20px;
}

.product-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:50px;
}

.slider-wrapper{
  position:relative;
  overflow:hidden;
}

.image-slider{
  display:flex;
  transition:0.5s ease;
}

.slide{
  min-width:100%;
}

.slide img{
  width:100%;
  height:500px;
  object-fit:cover;
  border-radius:8px;
  transition:transform 0.3s ease;
}

.slide img:hover{
  transform:scale(1.1);
}

.arrow{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  background:#fff;
  border:none;
  font-size:28px;
  width:40px;
  height:40px;
  cursor:pointer;
  z-index:2;
  box-shadow:0 2px 6px rgba(0,0,0,0.15);
}

.arrow.left{ left:5px; }
.arrow.right{ right:5px; }

.thumbs{
  display:flex;
  gap:10px;
  margin-top:10px;
  justify-content:center;
}

.thumb{
  width:60px;
  height:60px;
  object-fit:cover;
  cursor:pointer;
  border:1px solid #ddd;
}

.dots{
  text-align:center;
  margin-top:10px;
}

.dot{
  height:10px;
  width:10px;
  margin:0 4px;
  display:inline-block;
  background-color:#bbb;
  border-radius:50%;
  cursor:pointer;
  transition:background-color 0.3s ease;
}

.dot.active{
  background-color:#111;
}

.no-image{
  height:500px;
  background:#f4f4f4;
  display:flex;
  align-items:center;
  justify-content:center;
}

.no-image svg{
  width:120px;
  opacity:0.3;
}

.product-info h1{
  font-size:30px;
  margin-bottom:15px;
}

.price{
  font-size:22px;
  font-weight:bold;
  margin-bottom:20px;
}

.qty-row{
  margin:15px 0;
}

.qty-row input{
  width:70px;
  padding:6px;
}

.add-cart{
  background:#111;
  color:#fff;
  border:none;
  padding:12px 20px;
  cursor:pointer;
  margin-bottom:25px;
}

.description{
  margin-top:20px;
  line-height:1.6;
}

@media(max-width:900px){
  .product-grid{
    grid-template-columns:1fr;
  }
  .thumbs{ justify-content:flex-start; overflow-x:auto; }
}
</style>

<script>
let currentSlide = 0;
const slider = document.getElementById('imageSlider');
const dots = document.getElementById('dotsNav') ? document.getElementById('dotsNav').children : [];

function showSlide(index){
  if(!slider) return;
  const slides = slider.querySelectorAll('.slide');
  if(slides.length == 0) return;

  if(index >= slides.length) index = 0;
  if(index < 0) index = slides.length - 1;

  currentSlide = index;
  slider.style.transform = `translateX(-${100 * currentSlide}%)`;

  // update dots
  for(let i=0;i<dots.length;i++){
    dots[i].classList.remove('active');
  }
  if(dots[currentSlide]) dots[currentSlide].classList.add('active');
}

function slideImages(direction){
  showSlide(currentSlide + direction);
}

function goToSlide(index){
  showSlide(index);
}

// swipe support on mobile
let startX = 0;
let endX = 0;
if(slider){
  slider.addEventListener('touchstart', e => startX = e.touches[0].clientX);
  slider.addEventListener('touchmove', e => endX = e.touches[0].clientX);
  slider.addEventListener('touchend', e => {
    if(startX - endX > 30) slideImages(1);
    else if(endX - startX > 30) slideImages(-1);
  });
}

// initialize first slide
showSlide(0);
</script>

{% schema %}
{
  "name": "Main Product Slider",
  "settings": []
}
{% endschema %}
