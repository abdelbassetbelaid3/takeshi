<div class="ps-section">
  <div class="ps-grid">

    {% for block in section.blocks %}
      <div class="ps-item">
        <a href="#product-form" class="ps-link">
          {% if block.settings.image != blank %}
            <img 
              src="{{ block.settings.image | image_url: width: 800 }}" 
              alt="promo"
              loading="lazy"
            >
          {% endif %}
        </a>
      </div>
    {% endfor %}

  </div>
</div>

{% stylesheet %}
.ps-section{
  padding: 40px 20px;
}

/* GRID */
.ps-grid{
  display: grid;
  gap: 15px;
  grid-template-columns: 1fr; /* mobile */
}

/* tablet */
@media(min-width: 768px){
  .ps-grid{
    grid-template-columns: repeat(2, 1fr);
  }
}

/* desktop */
@media(min-width: 1024px){
  .ps-grid{
    grid-template-columns: repeat(3, 1fr);
  }
}

/* ITEM */
.ps-item{
  overflow: hidden;
}

.ps-item img{
  width: 100%;
  height: 250px;
  object-fit: cover;
  display: block;
  transition: 0.4s ease;
}

/* hover effect */
.ps-item:hover img{
  transform: scale(1.05);
}
{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".ps-link").forEach(link => {
    link.addEventListener("click", function(e) {
      e.preventDefault();

      const target = document.querySelector("#product-form");
      if (!target) return;

      target.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });
    });
  });
});
</script>

{% schema %}
{
  "name": "Promo Scroll Section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "image",
      "name": "Promo Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Scroll",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}