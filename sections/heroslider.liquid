<div class="neo-slider" id="neo-slider-{{ section.id }}">

  <button class="neo-slider__arrow neo-slider__arrow--left">
    &#10094;
  </button>

  <div class="neo-slider__viewport">

    <div class="neo-slider__track">

      {% assign loop_count = 12 %}

      {% for i in (1..loop_count) %}
        {% for block in section.blocks %}

          <div class="neo-slider__slide" {{ block.shopify_attributes }}>

            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}

            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt=""
                class="neo-slider__image"
                loading="lazy"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}

          </div>

        {% endfor %}
      {% endfor %}

    </div>

  </div>

  <button class="neo-slider__arrow neo-slider__arrow--right">
    &#10095;
  </button>

</div>

<style>
#neo-slider-{{ section.id }}{
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #fff;
}

/* viewport */

#neo-slider-{{ section.id }} .neo-slider__viewport{
  width: 100%;
  overflow: hidden;
}

/* track */

#neo-slider-{{ section.id }} .neo-slider__track{
  display: flex;
  gap: 6px;
  will-change: transform;
}

/* slides */

#neo-slider-{{ section.id }} .neo-slider__slide{
  flex: 0 0 28%;
  overflow: hidden;
  position: relative;
}

/* image */

#neo-slider-{{ section.id }} .neo-slider__image{
  width: 100%;
  height: 100vh;
  object-fit: cover;
  display: block;
}

/* arrows */

#neo-slider-{{ section.id }} .neo-slider__arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 30;

  width: 54px;
  height: 54px;

  border: none;
  background: transparent;

  color: #3b82f6;
  font-size: 44px;

  cursor: pointer;

  transition: .3s ease;
}

#neo-slider-{{ section.id }} .neo-slider__arrow:hover{
  opacity: .7;
}

#neo-slider-{{ section.id }} .neo-slider__arrow--left{
  left: 5px;
}

#neo-slider-{{ section.id }} .neo-slider__arrow--right{
  right: 5px;
}

/* mobile */

@media(max-width:768px){

  #neo-slider-{{ section.id }} .neo-slider__track{
    gap: 10px;
  }

  #neo-slider-{{ section.id }} .neo-slider__slide{
    flex: 0 0 82%;
  }

  #neo-slider-{{ section.id }} .neo-slider__image{
    height: 75vh;
  }

}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const slider = document.querySelector("#neo-slider-{{ section.id }}");

  const track = slider.querySelector(".neo-slider__track");

  const slides = slider.querySelectorAll(".neo-slider__slide");

  const nextBtn = slider.querySelector(".neo-slider__arrow--right");

  const prevBtn = slider.querySelector(".neo-slider__arrow--left");

  const originalSlides = {{ section.blocks.size }};

  const repeatCount = 12;

  /*
  START IN MIDDLE
  prevents white gaps forever
  */

  let index = originalSlides * Math.floor(repeatCount / 2);

  let isAnimating = false;

  function getSlideWidth(){

    const slide = slides[0];

    const styles = window.getComputedStyle(track);

    const gap = parseFloat(styles.columnGap || styles.gap || 0);

    return slide.getBoundingClientRect().width + gap;

  }

  function updateSlider(animated = true){

    if(animated){

      track.style.transition =
        "transform 1.1s cubic-bezier(.77,0,.175,1)";

    }else{

      track.style.transition = "none";

    }

    track.style.transform =
      `translateX(-${index * getSlideWidth()}px)`;

  }

  updateSlider(false);

  function nextSlide(){

    if(isAnimating) return;

    isAnimating = true;

    index++;

    updateSlider(true);

  }

  function prevSlide(){

    if(isAnimating) return;

    isAnimating = true;

    index--;

    updateSlider(true);

  }

  track.addEventListener("transitionend", ()=>{

    isAnimating = false;

    /*
    BEFORE REACHING END
    jump back silently to center
    */

    if(index >= originalSlides * (repeatCount - 3)){

      index = originalSlides * Math.floor(repeatCount / 2);

      updateSlider(false);

    }

    /*
    BEFORE REACHING START
    jump forward silently to center
    */

    if(index <= originalSlides){

      index = originalSlides * Math.floor(repeatCount / 2);

      updateSlider(false);

    }

  });

  /* arrows */

  nextBtn.addEventListener("click", ()=>{

    nextSlide();

    resetAuto();

  });

  prevBtn.addEventListener("click", ()=>{

    prevSlide();

    resetAuto();

  });

  /* autoplay */

  let autoSlide = setInterval(()=>{

    nextSlide();

  }, 4000);

  function resetAuto(){

    clearInterval(autoSlide);

    autoSlide = setInterval(()=>{

      nextSlide();

    }, 4000);

  }

  /* swipe */

  let startX = 0;

  let endX = 0;

  slider.addEventListener("touchstart", (e)=>{

    startX = e.touches[0].clientX;

  });

  slider.addEventListener("touchmove", (e)=>{

    endX = e.touches[0].clientX;

  });

  slider.addEventListener("touchend", ()=>{

    const diff = startX - endX;

    if(diff > 50){

      nextSlide();

    }

    if(diff < -50){

      prevSlide();

    }

    resetAuto();

  });

  /* resize */

  window.addEventListener("resize", ()=>{

    updateSlider(false);

  });

});
</script>

{% schema %}
{
  "name": "Premium Portrait Carousel",
  "settings": [],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Portrait Carousel"
    }
  ]
}
{% endschema %}