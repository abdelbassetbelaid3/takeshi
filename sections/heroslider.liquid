<div class="hero-slider" id="hero-slider-{{ section.id }}">
  
  <button class="hero-arrow hero-arrow--left" id="prev-{{ section.id }}">
    &#10094;
  </button>

  <div class="hero-slider__viewport">
    <div class="hero-slider__track" id="track-{{ section.id }}">

      {% for block in section.blocks %}
        <div class="hero-slide" {{ block.shopify_attributes }}>

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="hero-slide__link">
          {% endif %}

          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | img_url: '1600x' }}"
              alt=""
              class="hero-slide__image"
              loading="lazy"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>

  <button class="hero-arrow hero-arrow--right" id="next-{{ section.id }}">
    &#10095;
  </button>

</div>

<style>
#hero-slider-{{ section.id }}{
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #fff;
}

/* viewport */
#hero-slider-{{ section.id }} .hero-slider__viewport{
  width: 100%;
  overflow: hidden;
}

/* track */
#hero-slider-{{ section.id }} .hero-slider__track{
  display: flex;
  gap: 16px;
  transition: transform .8s cubic-bezier(.77,0,.175,1);
  will-change: transform;
  padding: 0 3vw;
}

/* slide */
#hero-slider-{{ section.id }} .hero-slide{
  position: relative;
  flex: 0 0 calc(33.333% - 11px);
  overflow: hidden;
  border-radius: 0;
}

/* image */
#hero-slider-{{ section.id }} .hero-slide__image{
  width: 100%;
  height: 100vh;
  object-fit: cover;
  display: block;
}

/* arrows */
#hero-slider-{{ section.id }} .hero-arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;

  width: 50px;
  height: 50px;

  border: none;
  background: transparent;
  color: #3b82f6;

  font-size: 42px;
  line-height: 1;
  cursor: pointer;

  transition: .25s ease;
}

#hero-slider-{{ section.id }} .hero-arrow:hover{
  opacity: .7;
}

#hero-slider-{{ section.id }} .hero-arrow--left{
  left: 12px;
}

#hero-slider-{{ section.id }} .hero-arrow--right{
  right: 12px;
}

/* mobile */
@media screen and (max-width: 768px){

  #hero-slider-{{ section.id }} .hero-slider__track{
    gap: 10px;
    padding: 0 12px;
  }

  #hero-slider-{{ section.id }} .hero-slide{
    flex: 0 0 88%;
  }

  #hero-slider-{{ section.id }} .hero-slide__image{
    height: 75vh;
  }

  #hero-slider-{{ section.id }} .hero-arrow{
    font-size: 30px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function(){

  const slider = document.getElementById('hero-slider-{{ section.id }}');
  const track = document.getElementById('track-{{ section.id }}');

  const slides = track.querySelectorAll('.hero-slide');

  const prevBtn = document.getElementById('prev-{{ section.id }}');
  const nextBtn = document.getElementById('next-{{ section.id }}');

  let index = 0;

  function visibleSlides(){
    return window.innerWidth <= 768 ? 1 : 3;
  }

  function slideWidth(){
    return slides[0].offsetWidth + 16;
  }

  function maxIndex(){
    return slides.length - visibleSlides();
  }

  function updateSlider(){
    track.style.transform =
      `translateX(-${index * slideWidth()}px)`;
  }

  function nextSlide(){
    index++;

    if(index > maxIndex()){
      index = 0;
    }

    updateSlider();
  }

  function prevSlide(){
    index--;

    if(index < 0){
      index = maxIndex();
    }

    updateSlider();
  }

  nextBtn.addEventListener('click', () => {
    nextSlide();
    resetAuto();
  });

  prevBtn.addEventListener('click', () => {
    prevSlide();
    resetAuto();
  });

  /* auto slide */
  let autoSlide = setInterval(nextSlide, 5000);

  function resetAuto(){
    clearInterval(autoSlide);
    autoSlide = setInterval(nextSlide, 5000);
  }

  /* swipe */
  let startX = 0;
  let endX = 0;

  slider.addEventListener('touchstart', (e)=>{
    startX = e.touches[0].clientX;
  });

  slider.addEventListener('touchmove', (e)=>{
    endX = e.touches[0].clientX;
  });

  slider.addEventListener('touchend', ()=>{

    let diff = startX - endX;

    if(diff > 50){
      nextSlide();
    }

    if(diff < -50){
      prevSlide();
    }

    resetAuto();
  });

  window.addEventListener('resize', updateSlider);

});
</script>

{% schema %}
{
  "name": "Anime Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anime Hero Slider"
    }
  ]
}
{% endschema %}