<div class="premium-carousel">
  <button class="carousel-arrow left" id="prev-{{ section.id }}">&#10094;</button>
  <div class="carousel-viewport" id="viewport-{{ section.id }}">
    <div class="carousel-track" id="track-{{ section.id }}">
{% for block in section.blocks %}
  <div class="carousel-item">
    {% if block.settings.link != blank %}
      <a href="{{ block.settings.link }}">
    {% endif %}

    {% if block.settings.image != blank %}
      <img src="{{ block.settings.image | img_url: '1000x' }}" alt="">
    {% else %}
      {{ 'image' | placeholder_svg_tag }}
    {% endif %}

    {% if block.settings.link != blank %}
      </a>
    {% endif %}
  </div>
{% endfor %}

    </div>
  </div>
  <button class="carousel-arrow right" id="next-{{ section.id }}">&#10095;</button>

  {% if section.blocks.size > 3 %}
  <div class="carousel-dots" id="dots-{{ section.id }}">
    {% assign dot_count = section.blocks.size | minus: 2 %}
    {% for i in (0..dot_count) %}
      <span class="dot {% if forloop.first %}active{% endif %}" data-index="{{ i }}"></span>
    {% endfor %}
  </div>
  {% endif %}
</div>

<style>
.premium-carousel{
  position: relative;
  width: 100%;
}

.carousel-viewport{
  overflow: hidden;
  width: 100%;
  padding-left: 5%;
}

.carousel-track{
  display: flex;
  transition: transform 2s cubic-bezier(0.77,0,0.175,1);
}

.carousel-item{
  flex: 0 0 26%;
  cursor: grab;
}

.carousel-item img,
.carousel-item svg{
  width: 100%;
  height: 100vh;
  object-fit: cover;
}

/* arrows */
.carousel-arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40px;
  color: #000;
  background: rgba(255,255,255,0.7);
  border: none;
  border-radius: 50%;
  width: 50px;
  height: 50px;
  cursor: pointer;
  z-index: 10;
}

.carousel-arrow.left{
  left: 10px;
}

.carousel-arrow.right{
  right: 10px;
}

/* dots */
.carousel-dots{
  text-align: center;
  margin-top: 20px;
}

.dot{
  width: 10px;
  height: 10px;
  display: inline-block;
  background: #ccc;
  margin: 5px;
  border-radius: 50%;
  cursor: pointer;
  transition: 0.3s;
}

.dot.active{
  background: #000;
  transform: scale(1.2);
}

/* Responsive */
@media(max-width: 768px){
  .carousel-item{
    flex: 0 0 70%;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const track = document.getElementById("track-{{ section.id }}");
  const items = track.querySelectorAll(".carousel-item");
  const dots = document.querySelectorAll("#dots-{{ section.id }} .dot");
  const prevBtn = document.getElementById("prev-{{ section.id }}");
  const nextBtn = document.getElementById("next-{{ section.id }}");
  const visibleItems = 3;
  const gap = 20;
  const maxIndex = items.length - visibleItems;
  let index = 0;
  let startX = 0;
  let isDragging = false;
  let currentTranslate = 0;
  let prevTranslate = 0;

  function update(){
    track.style.transform = `translateX(-${index * (items[0].offsetWidth + gap)}px)`;
    if(dots.length){
      dots.forEach(dot => dot.classList.remove("active"));
      if(dots[index]) dots[index].classList.add("active");
    }
  }

  function nextSlide(){
    index++;
    if(index > maxIndex) index = 0;
    update();
  }

  function prevSlide(){
    index--;
    if(index < 0) index = maxIndex;
    update();
  }

  // auto-slide
  let autoSlide = setInterval(nextSlide, 5000);

  // arrows
  nextBtn.addEventListener("click", ()=>{
    nextSlide();
    resetInterval();
  });
  prevBtn.addEventListener("click", ()=>{
    prevSlide();
    resetInterval();
  });

  // dots
  dots.forEach(dot=>{
    dot.addEventListener("click", function(){
      index = parseInt(this.dataset.index);
      update();
      resetInterval();
    });
  });

  function resetInterval(){
    clearInterval(autoSlide);
    autoSlide = setInterval(nextSlide, 6000);
  }

  // swipe support
  const viewport = document.getElementById("viewport-{{ section.id }}");

  viewport.addEventListener("touchstart", touchStart);
  viewport.addEventListener("touchmove", touchMove);
  viewport.addEventListener("touchend", touchEnd);

  function touchStart(e){
    isDragging = true;
    startX = e.touches[0].clientX;
    prevTranslate = index * (items[0].offsetWidth + gap);
  }

  function touchMove(e){
    if(!isDragging) return;
    const currentX = e.touches[0].clientX;
    const diff = startX - currentX;
    track.style.transform = `translateX(-${prevTranslate + diff}px)`;
  }

  function touchEnd(e){
    isDragging = false;
    const endX = e.changedTouches[0].clientX;
    const diff = startX - endX;
    if(diff > 50) nextSlide();
    else if(diff < -50) prevSlide();
    else update(); // snap back
    resetInterval();
  }

});
</script>

{% schema %}
{
  "name": "Premium Portrait Carousel",
  "settings": [],
"blocks": [
  {
    "type": "slide",
    "name": "Slide",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Slide image"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Slide link (Product or Collection)"
      }
    ]
  }
],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Premium Portrait Carousel",
      "blocks": [
      { "type": "slide" },
      { "type": "slide" }
    ]
    }
    
  ]
}
{% endschema %}
