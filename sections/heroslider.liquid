<div class="neo-slider" id="neo-slider-{{ section.id }}">

  <button class="neo-slider__arrow neo-slider__arrow--left" id="prev-{{ section.id }}">
    &#10094;
  </button>

  <div class="neo-slider__viewport">

    <div class="neo-slider__track" id="track-{{ section.id }}">

      {% for block in section.blocks %}

        <div class="neo-slider__slide" {{ block.shopify_attributes }}>

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">
          {% endif %}

          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | img_url: '1600x' }}"
              alt=""
              class="neo-slider__image"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>

  <button class="neo-slider__arrow neo-slider__arrow--right" id="next-{{ section.id }}">
    &#10095;
  </button>

  <div class="neo-slider__dots" id="dots-{{ section.id }}"></div>

</div>

<style>
#neo-slider-{{ section.id }}{
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #fff;
}

#neo-slider-{{ section.id }} .neo-slider__viewport{
  overflow: hidden;
  width: 100%;
}

#neo-slider-{{ section.id }} .neo-slider__track{
  display: flex;
  gap: 18px;
  transition: transform 1.2s cubic-bezier(.77,0,.175,1);
  will-change: transform;
  padding-left: 0;
}
#neo-slider-{{ section.id }} .neo-slider__slide{
  flex: 0 0 28%;
  overflow: hidden;
  position: relative;
}

#neo-slider-{{ section.id }} .neo-slider__image{
  width: 100%;
  height: 100vh;
  object-fit: cover;
  display: block;
}

/* arrows */

#neo-slider-{{ section.id }} .neo-slider__arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;

  width: 52px;
  height: 52px;

  border: none;
  background: transparent;

  font-size: 42px;
  color: #3b82f6;

  cursor: pointer;
}

#neo-slider-{{ section.id }} .neo-slider__arrow--left{
  left: 5px;
}

#neo-slider-{{ section.id }} .neo-slider__arrow--right{
  right: 5px;
}

/* dots */

#neo-slider-{{ section.id }} .neo-slider__dots{
  position: absolute;
  bottom: 18px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  z-index: 20;
}

#neo-slider-{{ section.id }} .neo-slider__dot{
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255,255,255,.4);
  transition: .3s;
  cursor: pointer;
}

#neo-slider-{{ section.id }} .neo-slider__dot.active{
  background: #fff;
  transform: scale(1.2);
}

/* mobile */

@media(max-width:768px){

  #neo-slider-{{ section.id }} .neo-slider__slide{
    flex: 0 0 82%;
  }

  #neo-slider-{{ section.id }} .neo-slider__image{
    height: 75vh;
  }

}
</style>
<script>
document.addEventListener("DOMContentLoaded", function(){

  const track = document.getElementById("track-{{ section.id }}");

  let slides = Array.from(track.children);

  const prevBtn = document.getElementById("prev-{{ section.id }}");
  const nextBtn = document.getElementById("next-{{ section.id }}");

  const dotsContainer = document.getElementById("dots-{{ section.id }}");

  /* CLONE FIRST + LAST */

  const firstClone = slides[0].cloneNode(true);
  const lastClone = slides[slides.length - 1].cloneNode(true);

  track.appendChild(firstClone);
  track.insertBefore(lastClone, slides[0]);

  slides = Array.from(track.children);

  let index = 1;

  function slideWidth(){
    return slides[0].offsetWidth + 18;
  }

  /* START POSITION */

  track.style.transform =
    `translateX(-${slideWidth() * index}px)`;

  /* DOTS */

  const realSlidesCount = slides.length - 2;

  for(let i = 0; i < realSlidesCount; i++){

    const dot = document.createElement("div");

    dot.classList.add("neo-slider__dot");

    if(i === 0){
      dot.classList.add("active");
    }

    dot.addEventListener("click", ()=>{

      index = i + 1;

      updateSlider();

      resetAuto();

    });

    dotsContainer.appendChild(dot);

  }

  const dots = dotsContainer.querySelectorAll(".neo-slider__dot");

  function updateDots(){

    dots.forEach(dot=>{
      dot.classList.remove("active");
    });

    let dotIndex = index - 1;

    if(dotIndex >= realSlidesCount){
      dotIndex = 0;
    }

    if(dotIndex < 0){
      dotIndex = realSlidesCount - 1;
    }

    if(dots[dotIndex]){
      dots[dotIndex].classList.add("active");
    }

  }

  function updateSlider(){

    track.style.transition =
      "transform 1.2s cubic-bezier(.77,0,.175,1)";

    track.style.transform =
      `translateX(-${slideWidth() * index}px)`;

    updateDots();

  }

  function nextSlide(){

    if(index >= slides.length - 1) return;

    index++;

    updateSlider();

  }

  function prevSlide(){

    if(index <= 0) return;

    index--;

    updateSlider();

  }

  /* seamless loop */

  track.addEventListener("transitionend", ()=>{

    /* reached fake last */

    if(slides[index] === firstClone){

      track.style.transition = "none";

      index = 1;

      track.style.transform =
        `translateX(-${slideWidth() * index}px)`;

    }

    /* reached fake first */

    if(slides[index] === lastClone){

      track.style.transition = "none";

      index = slides.length - 2;

      track.style.transform =
        `translateX(-${slideWidth() * index}px)`;

    }

  });

  nextBtn.addEventListener("click", ()=>{

    nextSlide();

    resetAuto();

  });

  prevBtn.addEventListener("click", ()=>{

    prevSlide();

    resetAuto();

  });

  /* AUTO */

  let autoSlide = setInterval(()=>{

    nextSlide();

  }, 4000);

  function resetAuto(){

    clearInterval(autoSlide);

    autoSlide = setInterval(()=>{

      nextSlide();

    }, 4000);

  }

  /* SWIPE */

  let startX = 0;
  let endX = 0;

  track.addEventListener("touchstart", (e)=>{

    startX = e.touches[0].clientX;

  });

  track.addEventListener("touchmove", (e)=>{

    endX = e.touches[0].clientX;

  });

  track.addEventListener("touchend", ()=>{

    const diff = startX - endX;

    if(diff > 50){

      nextSlide();

    }

    if(diff < -50){

      prevSlide();

    }

    resetAuto();

  });

  window.addEventListener("resize", ()=>{

    track.style.transition = "none";

    track.style.transform =
      `translateX(-${slideWidth() * index}px)`;

  });

});
</script>

{% schema %}
{
  "name": "Neo Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neo Hero Slider"
    }
  ]
}
{% endschema %}