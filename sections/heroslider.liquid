```liquid
<div class="neo-hero-slider" id="neo-slider-{{ section.id }}">

  <button class="neo-arrow neo-arrow--left" id="prev-{{ section.id }}">
    &#10094;
  </button>

  <div class="neo-slider__viewport">
    <div class="neo-slider__track" id="track-{{ section.id }}">

      {% for block in section.blocks %}

        <div class="neo-slide" {{ block.shopify_attributes }}>

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">
          {% endif %}

          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | img_url: '1600x' }}"
              alt=""
              class="neo-slide__image"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% endif %}

        </div>

      {% endfor %}

    </div>
  </div>

  <button class="neo-arrow neo-arrow--right" id="next-{{ section.id }}">
    &#10095;
  </button>

</div>

<style>
#neo-slider-{{ section.id }}{
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #fff;
}

/* viewport */
#neo-slider-{{ section.id }} .neo-slider__viewport{
  overflow: hidden;
  width: 100%;
}

/* track */
#neo-slider-{{ section.id }} .neo-slider__track{
  display: flex;
  gap: 18px;
  transition: transform 1.2s cubic-bezier(.77,0,.175,1);
  will-change: transform;
  padding-left: 2vw;
}

/* slide */
#neo-slider-{{ section.id }} .neo-slide{
  flex: 0 0 28%;
  position: relative;
  overflow: hidden;
}

/* image */
#neo-slider-{{ section.id }} .neo-slide__image{
  width: 100%;
  height: 100vh;
  object-fit: cover;
  display: block;
}

/* arrows */
#neo-slider-{{ section.id }} .neo-arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 50;

  width: 52px;
  height: 52px;

  border: none;
  background: transparent;

  font-size: 42px;
  color: #3b82f6;

  cursor: pointer;
  transition: .3s ease;
}

#neo-slider-{{ section.id }} .neo-arrow:hover{
  opacity: .7;
}

#neo-slider-{{ section.id }} .neo-arrow--left{
  left: 5px;
}

#neo-slider-{{ section.id }} .neo-arrow--right{
  right: 5px;
}

/* mobile */
@media(max-width: 768px){

  #neo-slider-{{ section.id }} .neo-slider__track{
    gap: 10px;
    padding-left: 12px;
  }

  #neo-slider-{{ section.id }} .neo-slide{
    flex: 0 0 82%;
  }

  #neo-slider-{{ section.id }} .neo-slide__image{
    height: 75vh;
  }

}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const track = document.getElementById("track-{{ section.id }}");
  const slides = track.querySelectorAll(".neo-slide");

  const nextBtn = document.getElementById("next-{{ section.id }}");
  const prevBtn = document.getElementById("prev-{{ section.id }}");

  let index = 0;

  /* IMPORTANT
     28% width + gap = shows:
     3 full slides + small part of 4th
  */

  function getSlideWidth(){
    const slide = slides[0];
    const gap = 18;
    return slide.offsetWidth + gap;
  }

  function maxIndex(){
    return slides.length - 1;
  }

  function updateSlider(){
    track.style.transform =
      `translateX(-${index * getSlideWidth()}px)`;
  }

  /* infinite loop */
  function nextSlide(){

    index++;

    if(index > maxIndex()){
      index = 0;
    }

    updateSlider();
  }

  function prevSlide(){

    index--;

    if(index < 0){
      index = maxIndex();
    }

    updateSlider();
  }

  nextBtn.addEventListener("click", ()=>{
    nextSlide();
    resetAuto();
  });

  prevBtn.addEventListener("click", ()=>{
    prevSlide();
    resetAuto();
  });

  /* auto smooth slide */
  let autoSlide = setInterval(()=>{
    nextSlide();
  }, 4000);

  function resetAuto(){
    clearInterval(autoSlide);

    autoSlide = setInterval(()=>{
      nextSlide();
    }, 4000);
  }

  /* swipe support */

  let startX = 0;
  let endX = 0;

  track.addEventListener("touchstart", (e)=>{
    startX = e.touches[0].clientX;
  });

  track.addEventListener("touchmove", (e)=>{
    endX = e.touches[0].clientX;
  });

  track.addEventListener("touchend", ()=>{

    const diff = startX - endX;

    if(diff > 50){
      nextSlide();
    }

    if(diff < -50){
      prevSlide();
    }

    resetAuto();
  });

  /* resize */
  window.addEventListener("resize", ()=>{
    updateSlider();
  });

});
</script>

{% schema %}
{
  "name": "Neo Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Neo Hero Slider"
    }
  ]
}
{% endschema %}
