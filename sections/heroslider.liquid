<div class="neo-slider" id="neo-slider-{{ section.id }}">

  <!-- LEFT ARROW -->
  <button class="neo-slider__arrow neo-slider__arrow--left">
    &#10094;
  </button>

  <!-- VIEWPORT -->
  <div class="neo-slider__viewport">

    <!-- TRACK -->
    <div class="neo-slider__track">

      {% assign loop_count = 12 %}

      {% for i in (1..loop_count) %}
        {% for block in section.blocks %}

          <div
            class="neo-slider__slide"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="neo-slider__link"
              >
            {% endif %}

            {% if block.settings.image != blank %}

              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt=""
                class="neo-slider__image"
                loading="lazy"
              >

            {% else %}

              {{ 'image' | placeholder_svg_tag }}

            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}

          </div>

        {% endfor %}
      {% endfor %}

    </div>

  </div>

  <!-- RIGHT ARROW -->
  <button class="neo-slider__arrow neo-slider__arrow--right">
    &#10095;
  </button>

</div>

<style>

#neo-slider-{{ section.id }}{
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #fff;
  padding: 20px 0;
}

/* VIEWPORT */

#neo-slider-{{ section.id }} .neo-slider__viewport{
  width: 100%;
  overflow: hidden;
}

/* TRACK */

#neo-slider-{{ section.id }} .neo-slider__track{
  display: flex;
  gap: 12px;
  will-change: transform;
}

/* SLIDES */

#neo-slider-{{ section.id }} .neo-slider__slide{
  position: relative;
  overflow: hidden;

  /* VERTICAL PORTRAIT */
  flex: 0 0 18%;

  aspect-ratio: 2 / 3;

  background: #f5f5f5;
}

/* LINK */

#neo-slider-{{ section.id }} .neo-slider__link{
  display: block;
  width: 100%;
  height: 100%;
}

/* IMAGE */

#neo-slider-{{ section.id }} .neo-slider__image{
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
  display: block;

  transition: transform .7s ease;
}

/* HOVER EFFECT */

#neo-slider-{{ section.id }} .neo-slider__slide:hover .neo-slider__image{
  transform: scale(1.06);
}

/* ARROWS */

#neo-slider-{{ section.id }} .neo-slider__arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 50;

  width: 54px;
  height: 54px;

  border: none;
  border-radius: 999px;

  background: rgba(255,255,255,.85);

  color: #111;
  font-size: 24px;

  cursor: pointer;

  backdrop-filter: blur(8px);

  transition: .3s ease;
}

#neo-slider-{{ section.id }} .neo-slider__arrow:hover{
  background: #111;
  color: #fff;
}

#neo-slider-{{ section.id }} .neo-slider__arrow--left{
  left: 12px;
}

#neo-slider-{{ section.id }} .neo-slider__arrow--right{
  right: 12px;
}

/* LARGE TABLET */

@media(max-width: 1200px){

  #neo-slider-{{ section.id }} .neo-slider__slide{
    flex: 0 0 24%;
  }

}

/* TABLET */

@media(max-width: 900px){

  #neo-slider-{{ section.id }} .neo-slider__slide{
    flex: 0 0 34%;
  }

}

/* MOBILE */

@media(max-width: 768px){

  #neo-slider-{{ section.id }} .neo-slider__track{
    gap: 10px;
  }

  #neo-slider-{{ section.id }} .neo-slider__slide{
    flex: 0 0 82%;
    aspect-ratio: 2 / 3;
  }

  #neo-slider-{{ section.id }} .neo-slider__arrow{
    width: 42px;
    height: 42px;
    font-size: 20px;
  }

}

</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const slider =
    document.querySelector("#neo-slider-{{ section.id }}");

  if(!slider) return;

  const track =
    slider.querySelector(".neo-slider__track");

  const slides =
    slider.querySelectorAll(".neo-slider__slide");

  const nextBtn =
    slider.querySelector(".neo-slider__arrow--right");

  const prevBtn =
    slider.querySelector(".neo-slider__arrow--left");

  const originalSlides =
    {{ section.blocks.size }};

  const repeatCount = 12;

  /*
  START FROM CENTER
  */

  let index =
    originalSlides * Math.floor(repeatCount / 2);

  let isAnimating = false;

  function getSlideWidth(){

    const slide = slides[0];

    const styles =
      window.getComputedStyle(track);

    const gap =
      parseFloat(styles.columnGap || styles.gap || 0);

    return slide.getBoundingClientRect().width + gap;

  }

  function updateSlider(animated = true){

    if(animated){

      track.style.transition =
        "transform 1s cubic-bezier(.77,0,.175,1)";

    }else{

      track.style.transition = "none";

    }

    track.style.transform =
      `translateX(-${index * getSlideWidth()}px)`;

  }

  updateSlider(false);

  function nextSlide(){

    if(isAnimating) return;

    isAnimating = true;

    index++;

    updateSlider(true);

  }

  function prevSlide(){

    if(isAnimating) return;

    isAnimating = true;

    index--;

    updateSlider(true);

  }

  track.addEventListener("transitionend", ()=>{

    isAnimating = false;

    /*
    LOOP END
    */

    if(index >= originalSlides * (repeatCount - 3)){

      index =
        originalSlides * Math.floor(repeatCount / 2);

      updateSlider(false);

    }

    /*
    LOOP START
    */

    if(index <= originalSlides){

      index =
        originalSlides * Math.floor(repeatCount / 2);

      updateSlider(false);

    }

  });

  /* ARROWS */

  nextBtn.addEventListener("click", ()=>{

    nextSlide();

    resetAuto();

  });

  prevBtn.addEventListener("click", ()=>{

    prevSlide();

    resetAuto();

  });

  /* AUTOPLAY */

  let autoSlide = setInterval(()=>{

    nextSlide();

  }, 4000);

  function resetAuto(){

    clearInterval(autoSlide);

    autoSlide = setInterval(()=>{

      nextSlide();

    }, 4000);

  }

  /* SWIPE */

  let startX = 0;
  let endX = 0;

  slider.addEventListener("touchstart", (e)=>{

    startX = e.touches[0].clientX;

  });

  slider.addEventListener("touchmove", (e)=>{

    endX = e.touches[0].clientX;

  });

  slider.addEventListener("touchend", ()=>{

    const diff = startX - endX;

    if(diff > 50){

      nextSlide();

    }

    if(diff < -50){

      prevSlide();

    }

    resetAuto();

  });

  /* RESIZE */

  window.addEventListener("resize", ()=>{

    updateSlider(false);

  });

});
</script>

{% schema %}
{
  "name": "Vertical Portrait Carousel",
  "settings": [],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertical Portrait Carousel"
    }
  ]
}
{% endschema %}