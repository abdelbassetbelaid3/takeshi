{% comment %}
  PRODUCT SECTION — BLOCK FIRST ARCHITECTURE
{% endcomment %}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
-%}

{% capture product_slider %}
<div class="product-slider" data-slider>
  <div class="product-slider__track">
    {% for image in product.images %}
      <div class="product-slider__slide">
        {% render 'image', class: 'product-image', image: image %}
      </div>
    {% endfor %}
  </div>

  <button class="product-slider__arrow product-slider__arrow--prev" aria-label="Previous image">
    ‹
  </button>

  <button class="product-slider__arrow product-slider__arrow--next" aria-label="Next image">
    ›
  </button>

  <div class="product-slider__dots"></div>
</div>
{% endcapture %}

{% capture quantity_selector %}
<div class="quantity-selector">
  <button type="button" class="qty-btn minus">−</button>

  <input
    type="number"
    name="quantity"
    min="1"
    value="1"
    class="qty-input"
  >

  <button type="button" class="qty-btn plus">+</button>
</div>
{% endcapture %}

<div class="product-layout">

  {{ product_slider }}

  <div class="summary">

    <section class="summary-item product-info">

      <h1>{{ product.title }}</h1>

      <p>{{ product.price | money }}</p>

      {% form 'product', product, id: 'product-form', class: 'shopify-product-form' %}

        <input
          type="hidden"
          name="id"
          id="selectedVariant"
          value="{{ selected_variant.id }}"
        >

        {{ quantity_selector }}

        {{ form | payment_button }}

        <input
          type="submit"
          value="Add to cart"
          class="add-to-cart"
        >

      {% endform %}

    </section>

    <section class="summary-item guide">

      {{ product.description }}

      <h3>🛒 How to Order</h3>

      <p>
        Select your size and quantity
        Click Order Now and fill in your details
        We’ll contact you to confirm your order
        Pay Cash on Delivery
      </p>

    </section>

  </div>

</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
