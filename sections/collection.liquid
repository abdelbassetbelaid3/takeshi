{% comment %}
  Collection template
{% endcomment %}

<h1 class="collection-title">
  {{ collection.title }}
</h1>

{% paginate collection.products by 20 %}

  <div class="collection-products">

    {% for product in collection.products %}

      <div class="collection-product">

        <a href="{{ product.url }}" class="collection-product__image-wrapper">

          {% if product.featured_image %}

            <img
              class="collection-product__image main-img"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.title }}"
              loading="lazy"
            >

            {% if product.images[1] %}
              <img
                class="collection-product__image hover-img"
                src="{{ product.images[1] | image_url: width: 900 }}"
                alt="{{ product.title }}"
                loading="lazy"
              >
            {% endif %}

          {% else %}

            <div class="collection-product__placeholder">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>

          {% endif %}

        </a>

        <div class="collection-product__content">

          <p class="collection-product__title">
            {{ product.title | escape | link_to: product.url }}
          </p>

          <p class="collection-product__price">
            {{ product.price | money }}
          </p>

        </div>

      </div>

    {% endfor %}

  </div>

  {% if paginate.pages > 1 %}
    <div class="pagination">

      {% if paginate.previous %}
        <a class="pagination__arrow" href="{{ paginate.previous.url }}">
          ←
        </a>
      {% endif %}

      {% for part in paginate.parts %}

        {% if part.is_link %}
          <a class="pagination__item" href="{{ part.url }}">
            {{ part.title }}
          </a>
        {% else %}
          <span class="pagination__item pagination__item--current">
            {{ part.title }}
          </span>
        {% endif %}

      {% endfor %}

      {% if paginate.next %}
        <a class="pagination__arrow" href="{{ paginate.next.url }}">
          →
        </a>
      {% endif %}

    </div>
  {% endif %}

{% endpaginate %}


{% comment %}
  Collection template
{% endcomment %}

<style>
.collection-title{
  margin:40px 5%;
  font-size:32px;
  font-weight:600;
}

.collection-products{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:20px;
  margin:0 5%;
}

.collection-product{
  width:100%;
}

.collection-product__image-wrapper{
  position:relative;
  display:block;
  overflow:hidden;
}

.collection-product__image{
  width:100%;
  aspect-ratio:2/3;
  object-fit:cover;
  display:block;
  transition:all .45s ease;
}

.hover-img{
  position:absolute;
  inset:0;
  opacity:0;
}

.collection-product__image-wrapper:hover .main-img{
  opacity:0;
  transform:scale(1.05);
}

.collection-product__image-wrapper:hover .hover-img{
  opacity:1;
  transform:scale(1.05);
}

.collection-product__placeholder{
  width:100%;
  aspect-ratio:2/3;
  background:#f5f5f5;
  display:flex;
  align-items:center;
  justify-content:center;
}

.collection-product__placeholder svg{
  width:50%;
  height:50%;
  opacity:.3;
}

.collection-product__content{
  padding-top:12px;
}

.collection-product__title{
  margin:0 0 6px;
  font-size:16px;
}

.collection-product__title a{
  color:#111;
  text-decoration:none;
}

.collection-product__price{
  margin:0;
  font-weight:600;
}

/* PAGINATION */

.pagination-wrapper{
  width:100%;
  display:flex;
  justify-content:center;
  margin:60px 0;
}

.pagination{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
}

.pagination__item,
.pagination__arrow{
  width:44px;
  height:44px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-decoration:none;
  border:1px solid #e5e5e5;
  background:#fff;
  color:#111;
  font-size:14px;
  font-weight:500;
  transition:.25s;
}

.pagination__item:hover,
.pagination__arrow:hover{
  background:#111;
  color:#fff;
  border-color:#111;
}

.pagination__item--current{
  background:#111;
  color:#fff;
  border-color:#111;
}

.pagination__item--dots{
  border:none;
  background:none;
  width:auto;
}

/* TABLET */

@media (max-width:900px){
  .collection-products{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

/* MOBILE */

@media (max-width:600px){

  .collection-products{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
    margin:0 15px;
  }

  .collection-title{
    margin:20px 15px;
    font-size:24px;
  }

  .collection-product__title{
    font-size:14px;
  }

  .pagination{
    gap:6px;
  }

  .pagination__item,
  .pagination__arrow{
    width:36px;
    height:36px;
    font-size:13px;
  }
}
</style>

<h1 class="collection-title">
  {{ collection.title }}
</h1>

{% paginate collection.products by 20 %}

  <div class="collection-products">

    {% for product in collection.products %}

      <div class="collection-product">

        <a href="{{ product.url }}" class="collection-product__image-wrapper">

          {% if product.featured_image %}

            <img
              class="collection-product__image main-img"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >

            {% if product.images.size > 1 %}
              <img
                class="collection-product__image hover-img"
                src="{{ product.images[1] | image_url: width: 900 }}"
                alt="{{ product.title | escape }}"
                loading="lazy"
              >
            {% endif %}

          {% else %}

            <div class="collection-product__placeholder">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>

          {% endif %}

        </a>

        <div class="collection-product__content">

          <p class="collection-product__title">
            <a href="{{ product.url }}">
              {{ product.title }}
            </a>
          </p>

          <p class="collection-product__price">
            {{ product.price | money }}
          </p>

        </div>

      </div>

    {% endfor %}

  </div>

  {% if paginate.pages > 1 %}

    <div class="pagination-wrapper">

      <div class="pagination">

        {% if paginate.previous %}
          <a class="pagination__arrow" href="{{ paginate.previous.url }}">
            ←
          </a>
        {% endif %}

        {% for part in paginate.parts %}

          {% if part.is_link %}

            <a class="pagination__item" href="{{ part.url }}">
              {{ part.title }}
            </a>

          {% elsif part.title == paginate.current_page %}

            <span class="pagination__item pagination__item--current">
              {{ part.title }}
            </span>

          {% else %}

            <span class="pagination__item pagination__item--dots">
              {{ part.title }}
            </span>

          {% endif %}

        {% endfor %}

        {% if paginate.next %}
          <a class="pagination__arrow" href="{{ paginate.next.url }}">
            →
          </a>
        {% endif %}

      </div>

    </div>

  {% endif %}

{% endpaginate %}

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
```
