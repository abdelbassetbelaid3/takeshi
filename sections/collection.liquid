{% comment %}
  Collection template
{% endcomment %}

<h1 class="collection-title">
  {{ collection.title }}
</h1>

<div class="collection-products">

  {% paginate collection.products by 20 %}

    {% for product in collection.products %}

      <div class="collection-product">

        <a href="{{ product.url }}" class="collection-product__image-wrapper">

          {% if product.featured_image %}

            <!-- MAIN IMAGE -->
            <img
              class="collection-product__image main-img"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.title }}"
              loading="lazy"
            >

            <!-- HOVER IMAGE -->
            {% if product.images[1] %}
              <img
                class="collection-product__image hover-img"
                src="{{ product.images[1] | image_url: width: 900 }}"
                alt="{{ product.title }}"
                loading="lazy"
              >
            {% endif %}

          {% else %}

            <!-- PLACEHOLDER -->
            <div class="collection-product__placeholder">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>

          {% endif %}

        </a>

        <!-- PRODUCT INFO -->
        <div class="collection-product__content">

          <p class="collection-product__title">
            {{ product.title | escape | link_to: product.url }}
          </p>

          <p class="collection-product__price">
            {{ product.price | money }}
          </p>

        </div>

      </div>

    {% endfor %}

    {{ paginate | default_pagination }}

  {% endpaginate %}

</div>

{% stylesheet %}

/* =========================
   PAGE TITLE
========================= */

.collection-title{
  margin: 40px 5%;
  font-size: 32px;
  font-weight: 600;
}


/* =========================
   GRID
========================= */

.collection-products{
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;

  margin-inline: 5%;
}


/* =========================
   CARD
========================= */

.collection-product{
  width: 100%;
}


/* =========================
   IMAGE WRAPPER
========================= */

.collection-product__image-wrapper{
  position: relative;

  display: block;

  overflow: hidden;
}


/* =========================
   IMAGES
========================= */

.collection-product__image{
  width: 100%;

  aspect-ratio: 2 / 3;

  object-fit: cover;

  display: block;

  transition: 0.45s ease;
}


/* =========================
   HOVER IMAGE
========================= */

.hover-img{
  position: absolute;

  inset: 0;

  opacity: 0;
}


/* =========================
   HOVER EFFECT
========================= */

.collection-product__image-wrapper:hover .main-img{
  opacity: 0;

  transform: scale(1.06);
}

.collection-product__image-wrapper:hover .hover-img{
  opacity: 1;

  transform: scale(1.06);
}


/* =========================
   PLACEHOLDER
========================= */

.collection-product__placeholder{
  width: 100%;

  aspect-ratio: 2 / 3;

  background: #f5f5f5;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;
}

.collection-product__placeholder svg{
  width: 50%;
  height: 50%;

  opacity: 0.3;
}


/* =========================
   CONTENT
========================= */

.collection-product__content{
  padding-top: 12px;
}

.collection-product__title{
  margin: 0 0 6px;

  font-size: 16px;
}

.collection-product__title a{
  text-decoration: none;

  color: #000;
}

.collection-product__price{
  margin: 0;

  font-weight: 600;
}


/* =========================
   TABLET
========================= */

@media (max-width: 900px){

  .collection-products{
    grid-template-columns: repeat(2, 1fr);
  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 600px){

  .collection-products{
    grid-template-columns: 1fr;

    gap: 15px;

    margin-inline: 15px;
  }

  .collection-title{
    margin: 20px 15px;

    font-size: 24px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}