<div class="product-details">


  {% render 'product-price', product: product %}



</div>
{% schema %}
{
  "name": "Product Main",
  "blocks": [
    {
      "type": "product-media",
      "name": "Product Media"
    },
    {
      "type": "product-details",
      "name": "Product Details",

      "blocks": [
        {
          "type": "price",
          "name": "Price Block"
        }
      ],

      "block_order": ["price"]
    }
  ],
  "presets": [
    {
      "name": "Product Page"
    }
  ]
}
{% endschema %}