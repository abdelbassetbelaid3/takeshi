{% doc %}
  @prompt
    create section accept 2 images one displayed for larger screen pc and second one for mobile and tablets
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    line-height: 0;
  }

  .ai-responsive-image-{{ ai_gen_id }} picture,
  .ai-responsive-image-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
  }

  .ai-responsive-image-{{ ai_gen_id }} img {
    height: auto;
  }

  .ai-responsive-image__placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #f2f2f2;
    line-height: normal;
  }

  .ai-responsive-image__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-responsive-image__empty-state-{{ ai_gen_id }} {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    color: #333333;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-responsive-image-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-responsive-image-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.desktop_image != blank or block.settings.mobile_image != blank %}
    <picture>
      {% if block.settings.mobile_image != blank %}
        <source media="(max-width: 1023px)" srcset="{{ block.settings.mobile_image | image_url: width: 1600 }}">
      {% endif %}
      {% if block.settings.desktop_image != blank %}
        <img src="{{ block.settings.desktop_image | image_url: width: 2400 }}" alt="{{ block.settings.desktop_image.alt | default: block.settings.image_alt | escape }}" loading="lazy" width="{{ block.settings.desktop_image.width }}" height="{{ block.settings.desktop_image.height }}">
      {% else %}
        <img src="{{ block.settings.mobile_image | image_url: width: 1600 }}" alt="{{ block.settings.mobile_image.alt | default: block.settings.image_alt | escape }}" loading="lazy" width="{{ block.settings.mobile_image.width }}" height="{{ block.settings.mobile_image.height }}">
      {% endif %}
    </picture>
  {% else %}
    <div class="ai-responsive-image__placeholder-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
      <div class="ai-responsive-image__empty-state-{{ ai_gen_id }}">Add desktop and mobile images to display the responsive image.</div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Responsive image",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile and tablet image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Responsive image"
    }
  ],
  "tag": null,
  "class": "responsive-image-block"
}
{% endschema %}