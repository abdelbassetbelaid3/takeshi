<div class="variant-picker" {{ block.shopify_attributes }}>

  <p>Options: {{ product.options.size }}</p>

  {% for option in product.options_with_values %}

    <h4>{{ option.name }}</h4>

    {% for value in option.values %}
      <button type="button">
        {{ value }}
      </button>
    {% endfor %}

  {% endfor %}

</div>

{% schema %}
{
  "name": "Variant picker",
  "presets": [
    {
      "name": "Variant picker"
    }
  ]
}
{% endschema %}