<div class="variant-picker" {{ block.shopify_attributes }}>

  {% unless product.has_only_default_variant %}

    {% for option in product.options_with_values %}

      <div class="variant-picker__group">

        <label class="variant-picker__label">
          {{ option.name }}
        </label>

        <select
          class="variant-picker__select"
          data-option-position="{{ option.position }}"
        >

          {% for value in option.values %}

            <option
              value="{{ value }}"
              {% if option.selected_value == value %}
                selected
              {% endif %}
            >
              {{ value }}
            </option>

          {% endfor %}

        </select>

      </div>

    {% endfor %}

  {% endunless %}

</div>

{% stylesheet %}

.variant-picker {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.variant-picker__group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.variant-picker__label {
  font-size: 14px;
  font-weight: 600;
}

.variant-picker__select {
  width: 100%;
  height: 48px;
  padding: 0 14px;
  border: 1px solid #ddd;
  background: #fff;
  font-size: 14px;
  outline: none;
  cursor: pointer;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Variant picker"
}
{% endschema %}