{% unless product.has_only_default_variant %}

<div
  class="variant-picker"
  data-variant-picker
  data-variants='{{ product.variants | json | escape }}'
  {{ block.shopify_attributes }}
>

  {% for option in product.options_with_values %}

    <div class="variant-option">

      <div class="variant-option__label">
        {{ option.name }}
      </div>

      <div class="variant-option__values">

        {% for value in option.values %}

          <button
            type="button"
            class="variant-value {% if option.selected_value == value %}is-active{% endif %}"
            data-option-position="{{ forloop.parentloop.index0 }}"
            data-option-value="{{ value }}"
          >
            {{ value }}
          </button>

        {% endfor %}

      </div>

    </div>

  {% endfor %}

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

  const picker = document.querySelector('[data-variant-picker]');
  if (!picker) return;

  const variants = JSON.parse(
    picker.dataset.variants
  );

  const buttons = picker.querySelectorAll('.variant-value');

  buttons.forEach(button => {

    button.addEventListener('click', () => {

      const group = button.closest('.variant-option');

      group.querySelectorAll('.variant-value')
        .forEach(btn => btn.classList.remove('is-active'));

      button.classList.add('is-active');

      const selectedOptions = [];

      picker.querySelectorAll('.variant-option').forEach(option => {

        const active = option.querySelector('.variant-value.is-active');

        if (active) {
          selectedOptions.push(active.dataset.optionValue);
        }

      });

      const variant = variants.find(v =>
        v.options.every((opt, index) =>
          opt === selectedOptions[index]
        )
      );

      if (!variant) return;

      const idInput = document.querySelector(
        '.product-form input[name="id"]'
      );

      if (idInput) {
        idInput.value = variant.id;
      }

    });

  });

});
</script>

{% endunless %}

{% stylesheet %}

.variant-picker {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.variant-option__label {
  margin-bottom: 10px;
  font-weight: 600;
}

.variant-option__values {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.variant-value {
  border: 1px solid #ddd;
  background: #fff;
  padding: 10px 18px;
  cursor: pointer;
}

.variant-value.is-active {
  background: #111;
  color: #fff;
  border-color: #111;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Variant picker",
  "presets": [
    {
      "name": "Variant picker"
    }
  ]
}
{% endschema %}