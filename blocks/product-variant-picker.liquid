{% unless product.has_only_default_variant %}

<div class="variant-picker" {{ block.shopify_attributes }}>

  {% for option in product.options_with_values %}

    <div class="variant-picker__option">

      <label class="variant-picker__label">
        {{ option.name }}
      </label>

      <div class="variant-picker__values">

        {% for value in option.values %}

          {% assign option_index = option.position | minus: 1 %}

          {% assign checked = false %}
          {% if value == option.selected_value %}
            {% assign checked = true %}
          {% endif %}

          <label class="variant-picker__value">

            <input
              type="radio"
              name="option-{{ option.position }}"
              value="{{ value }}"
              {% if checked %}
                checked
              {% endif %}
            >

            <span>{{ value }}</span>

          </label>

        {% endfor %}

      </div>

    </div>

  {% endfor %}

</div>

{% endunless %}

{% stylesheet %}

.variant-picker {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.variant-picker__label {
  display: block;
  margin-bottom: 10px;
  font-size: 14px;
  font-weight: 600;
}

.variant-picker__values {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.variant-picker__value {
  position: relative;
  cursor: pointer;
}

.variant-picker__value input {
  display: none;
}

.variant-picker__value span {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 48px;
  min-height: 48px;
  padding: 0 16px;
  border: 1px solid #dcdcdc;
  transition: .2s;
}

.variant-picker__value input:checked + span {
  background: #111;
  color: #fff;
  border-color: #111;
}

.variant-picker__value:hover span {
  border-color: #111;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Variant picker",
  "presets": [
    {
      "name": "Variant picker"
    }
  ]
}
{% endschema %}