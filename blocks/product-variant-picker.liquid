<div {{ block.shopify_attributes }}>
  <p>Product: {{ product.title }}</p>
  <p>Variants: {{ product.variants.size }}</p>

  {% for variant in product.variants %}
    <p>{{ variant.title }} - {{ variant.id }}</p>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Variant picker",
  "presets": [
    {
      "name": "Variant picker"
    }
  ]
}
{% endschema %}