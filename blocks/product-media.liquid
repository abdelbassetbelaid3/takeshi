<div class="product-media" data-media {{ block.shopify_attributes }}>

  <!-- TRACK -->
  <div class="product-media__track">

    {% for image in product.images %}

      <div class="product-media__slide">

        <div class="product-media__image-wrap">

          {% render 'image',
            class: 'product-image',
            image: image
          %}

        </div>

      </div>

    {% endfor %}

  </div>

  <!-- PREV -->
  <button
    class="product-media__arrow product-media__arrow--prev"
    aria-label="Previous image"
  >
    &#10094;
  </button>

  <!-- NEXT -->
  <button
    class="product-media__arrow product-media__arrow--next"
    aria-label="Next image"
  >
    &#10095;
  </button>

  <!-- DOTS -->
  <div
    class="product-media__dots"
    role="tablist"
    aria-label="Image pagination"
  ></div>

</div>

{% stylesheet %}

/* =========================
   WRAPPER
========================= */

.product-media{
  position: relative;
  width: 100%;
  overflow: hidden;

  background: #f3f3f3;

  padding: 14px 0 55px;
}

/* =========================
   TRACK
========================= */

.product-media__track{
  display: flex;
  gap: 10px;

  overflow-x: auto;

  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;

  scrollbar-width: none;
}

.product-media__track::-webkit-scrollbar{
  display: none;
}

/* =========================
   SLIDES
========================= */

/* MOBILE */

.product-media__slide{
  flex: 0 0 100%;
  scroll-snap-align: center;
}

/* TABLET */

@media(min-width:768px){

  .product-media__slide{
    flex: 0 0 calc(50% - 5px);
  }

}

/* DESKTOP */
/* EXACTLY 3 IMAGES */

@media(min-width:1024px){

  .product-media__slide{
    flex: 0 0 calc(33.333% - 7px);
  }

}

/* =========================
   IMAGE WRAPPER
========================= */

.product-media__image-wrap{
  position: relative;
  overflow: hidden;

  aspect-ratio: 3 / 4;

  width: 100%;
  height: 100%;

  background: #e9e9e9;
}

/* =========================
   IMAGE
========================= */

.product-image{
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;
}

.product-image img{
  width: 100%;
  height: 100%;

  object-fit: cover;
  display: block;
}

.product-image img{
  position: absolute;
  inset: 0;

  object-fit: cover;
  display: block;

  transition: transform .7s ease;
}

/* HOVER */

.product-media__slide:hover .product-image img{
  transform: scale(1.04);
}

/* =========================
   ARROWS
========================= */

.product-media__arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;

  width: 52px;
  height: 52px;

  border: none;
  border-radius: 999px;

  background: rgba(255,255,255,.92);

  color: #111;
  font-size: 24px;

  cursor: pointer;

  transition: .3s ease;

  backdrop-filter: blur(6px);

  box-shadow: 0 4px 20px rgba(0,0,0,.08);
}

.product-media__arrow:hover{
  background: #111;
  color: #fff;
}

.product-media__arrow--prev{
  left: 16px;
}

.product-media__arrow--next{
  right: 16px;
}

/* =========================
   DOTS
========================= */

.product-media__dots{
  position: absolute;

  left: 50%;
  bottom: 18px;

  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 8px;
}

.product-media__dot{
  width: 7px;
  height: 7px;

  border-radius: 999px;
  border: none;

  background: #bbb;

  cursor: pointer;

  transition: .3s ease;
}

.product-media__dot.is-active{
  background: #111;
  transform: scale(1.2);
}

/* =========================
   MOBILE
========================= */

@media(max-width:767px){

  .product-media{
    padding-bottom: 45px;
  }

  .product-media__track{
    gap: 8px;
  }

  .product-media__slide{
    flex: 0 0 85%;
  }

  .product-media__arrow{
    width: 42px;
    height: 42px;

    font-size: 18px;
  }

  .product-media__arrow--prev{
    left: 8px;
  }

  .product-media__arrow--next{
    right: 8px;
  }

}

{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", () => {

  const root =
    document.querySelector("[data-media]");

  if(!root) return;

  const track =
    root.querySelector(".product-media__track");

  const prev =
    root.querySelector(".product-media__arrow--prev");

  const next =
    root.querySelector(".product-media__arrow--next");

  const dotsWrap =
    root.querySelector(".product-media__dots");

  let isAnimating = false;

  /*
  =========================
  ORIGINAL SLIDES
  =========================
  */

  const originalSlides =
    Array.from(
      track.querySelectorAll(".product-media__slide")
    );

  if(originalSlides.length <= 1) return;

  /*
  =========================
  CREATE CLONES
  =========================
  */

  const firstClone =
    originalSlides[0].cloneNode(true);

  const secondClone =
    originalSlides[1]
      ? originalSlides[1].cloneNode(true)
      : originalSlides[0].cloneNode(true);

  const lastClone =
    originalSlides[
      originalSlides.length - 1
    ].cloneNode(true);

  const beforeLastClone =
    originalSlides[
      originalSlides.length - 2
    ]
      ? originalSlides[
          originalSlides.length - 2
        ].cloneNode(true)
      : originalSlides[
          originalSlides.length - 1
        ].cloneNode(true);

  firstClone.classList.add("is-clone");
  secondClone.classList.add("is-clone");
  lastClone.classList.add("is-clone");
  beforeLastClone.classList.add("is-clone");

  /*
  APPEND
  */

  track.appendChild(firstClone);
  track.appendChild(secondClone);

  /*
  PREPEND
  */

  track.insertBefore(
    beforeLastClone,
    originalSlides[0]
  );

  track.insertBefore(
    lastClone,
    originalSlides[0]
  );

  /*
  =========================
  ALL SLIDES
  =========================
  */

  const getSlides = () =>
    Array.from(
      track.querySelectorAll(".product-media__slide")
    );

  let currentIndex = 2;

  /*
  =========================
  STEP
  =========================
  */

  function getStep(){

    const slide = getSlides()[0];

    const styles =
      window.getComputedStyle(track);

    const gap =
      parseFloat(styles.columnGap || styles.gap || 0);

    return slide.getBoundingClientRect().width + gap;

  }

  /*
  =========================
  INIT
  =========================
  */

  function init(){

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "auto"
    });

  }

  init();

  /*
  =========================
  GO TO
  =========================
  */

  function goTo(index){

    if(isAnimating) return;

    isAnimating = true;

    currentIndex = index;

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "smooth"
    });

    updateDots();

    setTimeout(() => {

      fixInfiniteLoop();

      isAnimating = false;

    }, 500);

  }

  /*
  =========================
  INFINITE LOOP FIX
  =========================
  */

  function fixInfiniteLoop(){

    const slides = getSlides();

    /*
    END
    */

    if(currentIndex >= slides.length - 2){

      currentIndex = 2;

      track.scrollTo({
        left: getStep() * currentIndex,
        behavior: "auto"
      });

    }

    /*
    START
    */

    if(currentIndex <= 1){

      currentIndex =
        slides.length - 4;

      track.scrollTo({
        left: getStep() * currentIndex,
        behavior: "auto"
      });

    }

  }

  /*
  =========================
  NEXT
  =========================
  */

  next.addEventListener("click", () => {

    goTo(currentIndex + 1);

  });

  /*
  =========================
  PREV
  =========================
  */

  prev.addEventListener("click", () => {

    goTo(currentIndex - 1);

  });

  /*
  =========================
  DOTS
  =========================
  */

  originalSlides.forEach((_, index) => {

    const dot =
      document.createElement("button");

    dot.className =
      "product-media__dot";

    dot.addEventListener("click", () => {

      goTo(index + 2);

    });

    dotsWrap.appendChild(dot);

  });

  function updateDots(){

    const dots =
      dotsWrap.querySelectorAll(".product-media__dot");

    let realIndex =
      currentIndex - 2;

    if(realIndex < 0){
      realIndex =
        originalSlides.length - 1;
    }

    if(realIndex >= originalSlides.length){
      realIndex = 0;
    }

    dots.forEach((dot, index) => {

      dot.classList.toggle(
        "is-active",
        index === realIndex
      );

    });

  }

  updateDots();

  /*
  =========================
  AUTOPLAY
  =========================
  */

  let autoPlay =
    setInterval(() => {

      goTo(currentIndex + 1);

    }, 4000);

  function resetAuto(){

    clearInterval(autoPlay);

    autoPlay =
      setInterval(() => {

        goTo(currentIndex + 1);

      }, 4000);

  }

  next.addEventListener("click", resetAuto);
  prev.addEventListener("click", resetAuto);

  /*
  =========================
  TOUCH SWIPE
  =========================
  */

  let startX = 0;
  let endX = 0;

  root.addEventListener("touchstart", (e) => {

    startX = e.touches[0].clientX;

  });

  root.addEventListener("touchmove", (e) => {

    endX = e.touches[0].clientX;

  });

  root.addEventListener("touchend", () => {

    const diff = startX - endX;

    if(diff > 50){

      goTo(currentIndex + 1);

    }

    if(diff < -50){

      goTo(currentIndex - 1);

    }

    resetAuto();

  });

  /*
  =========================
  RESIZE
  =========================
  */

  window.addEventListener("resize", () => {

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "auto"
    });

  });

});
</script>

{% schema %}
{
  "name": "Product media",
  "presets": [
    {
      "name": "Product media"
    }
  ]
}
{% endschema %}