<div class="product-media" data-media {{ block.shopify_attributes }}>

  <div class="product-media__track">

    {% for image in product.images %}
      <div class="product-media__slide">
        {% render 'image', class: 'product-image', image: image %}
      </div>
    {% endfor %}

  </div>

  <button class="product-media__arrow product-media__arrow--prev"
          aria-label="Previous image">‹</button>

  <button class="product-media__arrow product-media__arrow--next"
          aria-label="Next image">›</button>

  <div class="product-media__dots"
       role="tablist"
       aria-label="Image pagination"></div>

</div>
{% stylesheet %}

/* =========================
   media BASE
========================= */

.product-media {
  position: relative;
  max-width: 100%;
  overflow: hidden;
  margin: auto;
}

.product-media__track {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.product-media__track::-webkit-scrollbar {
  display: none;
}

/* DEFAULT (mobile) */
.product-media__slide {
  flex: 0 0 100%;
  scroll-snap-align: center;
}

/* =========================
   TABLET (2 SLIDES)
========================= */
@media (min-width: 768px) {
  .product-media__slide {
    flex: 0 0 50%;
  }
}

/* =========================
   DESKTOP (3 PORTRAIT MODE)
========================= */
@media (min-width: 1024px) {
  .product-media__slide {
    flex: 0 0 33.333%;
  }
}

/* IMAGE */
.product-image img {
  width: 100%;
  height: 650px;
  object-fit: cover;
  display: block;
}

/* =========================
   ARROWS
========================= */

.product-media__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: rgba(0,0,0,0.5);
  color: #fff;
  cursor: pointer;
  z-index: 10;
}

.product-media__arrow--prev { left: 10px; }
.product-media__arrow--next { right: 10px; }

/* =========================
   DOTS
========================= */

.product-media__dots {
  position: absolute;
  bottom: 10px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 6px;
}

.product-media__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: #ccc;
  cursor: pointer;
}

.product-media__dot.is-active {
  background: #000;
}

{% endstylesheet %}
<script>
document.addEventListener("DOMContentLoaded", () => {

  const root = document.querySelector("[data-media]");
  if (!root) return;

  const track = root.querySelector(".product-media__track");
  const prev = root.querySelector(".product-media__arrow--prev");
  const next = root.querySelector(".product-media__arrow--next");
  const dotsWrap = root.querySelector(".product-media__dots");

  let currentIndex = 1;
  let isAnimating = false;

  /* =========================
     ORIGINAL SLIDES ONLY
  ========================= */
  const originalSlides = Array.from(track.querySelectorAll(".product-media__slide"));

  if (originalSlides.length <= 1) return;

  /* =========================
     CLONES
  ========================= */
  const firstClone = originalSlides[0].cloneNode(true);
  const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);

  firstClone.classList.add("is-clone");
  lastClone.classList.add("is-clone");

  track.appendChild(firstClone);
  track.insertBefore(lastClone, originalSlides[0]);

  /* =========================
     ALL SLIDES (INCLUDING CLONES)
  ========================= */
  const getAllSlides = () =>
    Array.from(track.querySelectorAll(".product-media__slide"));

  const getStep = () => getAllSlides()[0].offsetWidth + 10;

  /* =========================
     INIT POSITION
  ========================= */
  const init = () => {
    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "auto"
    });
  };

  init();

  /* =========================
     GO TO SLIDE
  ========================= */
  function goTo(i) {
    if (isAnimating) return;
    isAnimating = true;

    currentIndex = i;

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "smooth"
    });

    setTimeout(() => {
      fixLoopEdges();
      updateDots();
      isAnimating = false;
    }, 350);
  }

  /* =========================
     INFINITE LOOP FIX
  ========================= */
  function fixLoopEdges() {
    const all = getAllSlides();

    if (currentIndex === all.length - 1) {
      currentIndex = 1;
      track.scrollTo({
        left: getStep() * currentIndex,
        behavior: "auto"
      });
    }

    if (currentIndex === 0) {
      currentIndex = all.length - 2;
      track.scrollTo({
        left: getStep() * currentIndex,
        behavior: "auto"
      });
    }
  }

  /* =========================
     NAVIGATION
  ========================= */
  next.addEventListener("click", () => goTo(currentIndex + 1));
  prev.addEventListener("click", () => goTo(currentIndex - 1));

  /* =========================
     DOTS
  ========================= */
  const total = originalSlides.length;

  for (let i = 0; i < total; i++) {
    const dot = document.createElement("button");
    dot.className = "product-media__dot";
    dot.addEventListener("click", () => goTo(i + 1));
    dotsWrap.appendChild(dot);
  }

  function updateDots() {
    const dots = dotsWrap.querySelectorAll(".product-media__dot");

    let realIndex = currentIndex - 1;

    if (realIndex < 0) realIndex = total - 1;
    if (realIndex >= total) realIndex = 0;

    dots.forEach((dot, i) => {
      dot.classList.toggle("is-active", i === realIndex);
    });
  }

  updateDots();

});
</script>


{% schema %}
{
  "name": "Product media",
  "presets": [
    {
      "name": "Product media"
    }
  ]
}
{% endschema %}