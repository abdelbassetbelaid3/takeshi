<div class="product-media" data-media {{ block.shopify_attributes }}>

  <!-- TRACK -->
  <div class="product-media__track">

    {% for image in product.images %}

      <div class="product-media__slide">

        <div class="product-media__image-wrap">

          {% render 'image',
            class: 'product-image',
            image: image
          %}

        </div>

      </div>

    {% endfor %}

  </div>

  <!-- PREV -->
  <button
    class="product-media__arrow product-media__arrow--prev"
    aria-label="Previous image"
  >
    &#10094;
  </button>

  <!-- NEXT -->
  <button
    class="product-media__arrow product-media__arrow--next"
    aria-label="Next image"
  >
    &#10095;
  </button>

  <!-- DOTS -->
  <div
    class="product-media__dots"
    role="tablist"
    aria-label="Image pagination"
  ></div>

</div>

{% stylesheet %}

/* =========================
   WRAPPER
========================= */

.product-media{
  position: relative;
  width: 100%;
  overflow: hidden;

  background: #f3f3f3;

  padding: 14px 0 55px;
}

/* =========================
   TRACK
========================= */

.product-media__track{
  display: flex;
  gap: 10px;

  overflow-x: auto;

  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;

  scrollbar-width: none;
}

.product-media__track::-webkit-scrollbar{
  display: none;
}

/* =========================
   SLIDES
========================= */

/* MOBILE */

.product-media__slide{
  flex: 0 0 100%;
  scroll-snap-align: center;
}

/* TABLET */

@media(min-width:768px){

  .product-media__slide{
    flex: 0 0 calc(50% - 5px);
  }

}

/* DESKTOP */
/* EXACTLY 3 IMAGES */

@media(min-width:1024px){

  .product-media__slide{
    flex: 0 0 calc(33.333% - 7px);
  }

}

/* =========================
   IMAGE WRAPPER
========================= */

.product-media__image-wrap{
  position: relative;
  overflow: hidden;

  /* PORTRAIT */
  aspect-ratio: 3 / 4;

  background: #e9e9e9;
}

/* =========================
   IMAGE
========================= */

.product-image,
.product-image img{
  width: 100%;
  height: 100%;
}

.product-image img{
  position: absolute;
  inset: 0;

  object-fit: cover;
  display: block;

  transition: transform .7s ease;
}

/* HOVER */

.product-media__slide:hover .product-image img{
  transform: scale(1.04);
}

/* =========================
   ARROWS
========================= */

.product-media__arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;

  width: 52px;
  height: 52px;

  border: none;
  border-radius: 999px;

  background: rgba(255,255,255,.92);

  color: #111;
  font-size: 24px;

  cursor: pointer;

  transition: .3s ease;

  backdrop-filter: blur(6px);

  box-shadow: 0 4px 20px rgba(0,0,0,.08);
}

.product-media__arrow:hover{
  background: #111;
  color: #fff;
}

.product-media__arrow--prev{
  left: 16px;
}

.product-media__arrow--next{
  right: 16px;
}

/* =========================
   DOTS
========================= */

.product-media__dots{
  position: absolute;

  left: 50%;
  bottom: 18px;

  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 8px;
}

.product-media__dot{
  width: 7px;
  height: 7px;

  border-radius: 999px;
  border: none;

  background: #bbb;

  cursor: pointer;

  transition: .3s ease;
}

.product-media__dot.is-active{
  background: #111;
  transform: scale(1.2);
}

/* =========================
   MOBILE
========================= */

@media(max-width:767px){

  .product-media{
    padding-bottom: 45px;
  }

  .product-media__track{
    gap: 8px;
  }

  .product-media__slide{
    flex: 0 0 85%;
  }

  .product-media__arrow{
    width: 42px;
    height: 42px;

    font-size: 18px;
  }

  .product-media__arrow--prev{
    left: 8px;
  }

  .product-media__arrow--next{
    right: 8px;
  }

}

{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", () => {

  const root =
    document.querySelector("[data-media]");

  if(!root) return;

  const track =
    root.querySelector(".product-media__track");

  const prev =
    root.querySelector(".product-media__arrow--prev");

  const next =
    root.querySelector(".product-media__arrow--next");

  const dotsWrap =
    root.querySelector(".product-media__dots");

  let currentIndex = 0;
  let isAnimating = false;

  /* =========================
     SLIDES
  ========================= */

  const slides =
    Array.from(
      track.querySelectorAll(".product-media__slide")
    );

  if(slides.length <= 1) return;

  /* =========================
     STEP
  ========================= */

  const getStep = () => {

    const slide = slides[0];

    const styles =
      window.getComputedStyle(track);

    const gap =
      parseFloat(styles.columnGap || styles.gap || 0);

    return slide.getBoundingClientRect().width + gap;

  };

  /* =========================
     GO TO
  ========================= */

  function goTo(index){

    if(isAnimating) return;

    isAnimating = true;

    currentIndex = index;

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "smooth"
    });

    updateDots();

    setTimeout(() => {

      isAnimating = false;

    }, 500);

  }

  /* =========================
     NEXT
  ========================= */

  next.addEventListener("click", () => {

    if(currentIndex >= slides.length - 1){

      currentIndex = 0;

    }else{

      currentIndex++;

    }

    goTo(currentIndex);

  });

  /* =========================
     PREV
  ========================= */

  prev.addEventListener("click", () => {

    if(currentIndex <= 0){

      currentIndex = slides.length - 1;

    }else{

      currentIndex--;

    }

    goTo(currentIndex);

  });

  /* =========================
     DOTS
  ========================= */

  slides.forEach((_, index) => {

    const dot =
      document.createElement("button");

    dot.className =
      "product-media__dot";

    dot.addEventListener("click", () => {

      goTo(index);

    });

    dotsWrap.appendChild(dot);

  });

  function updateDots(){

    const dots =
      dotsWrap.querySelectorAll(".product-media__dot");

    dots.forEach((dot, index) => {

      dot.classList.toggle(
        "is-active",
        index === currentIndex
      );

    });

  }

  updateDots();

  /* =========================
     RESIZE
  ========================= */

  window.addEventListener("resize", () => {

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "auto"
    });

  });

});
</script>

