{%- comment -%}
  Product Media Slider Component
  - Image slider
  - Arrows navigation
  - Dots pagination (JS controlled)
{%- endcomment -%}

<div class="product-slider" data-slider>

  <div class="product-slider__track">

    {% for image in product.images %}

      <div class="product-slider__slide">

        {% render 'image',
          class: 'product-image',
          image: image
        %}

      </div>

    {% endfor %}

  </div>

  <!-- NAVIGATION -->
  <button class="product-slider__arrow product-slider__arrow--prev"
          aria-label="Previous image"
          type="button">
    ‹
  </button>

  <button class="product-slider__arrow product-slider__arrow--next"
          aria-label="Next image"
          type="button">
    ›
  </button>

  <!-- DOTS (JS generated or hydrated) -->
  <div class="product-slider__dots"
       role="tablist"
       aria-label="Image pagination"></div>

</div>

{% stylesheet %}
.product-slider__track {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none; /* Firefox */
  gap: 10px;
}
.product-slider__track::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.product-slider__slide {
  flex: 0 0 100%;
  scroll-snap-align: center;
}

.product-image img {
  width: 500px;
  height: 650px;
  display: block;
  object-fit: cover;
}
/* Tablet: 2 slides per view */
@media (min-width: 768px) {
  .product-slider__slide {
    flex: 0 0 50%;
  }
}

/* Desktop: 3 slides per view */
@media (min-width: 1024px) {
  .product-slider__slide {
    flex: 0 0 33.333%;
  }
}


.product-slider__arrow--prev { left: 10px; }
.product-slider__arrow--next { right: 10px; }

/* Dots */
.product-slider__dots {
  position: absolute;
  bottom: 10px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 6px;
  z-index: 10;
}

.product-slider__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ccc;
  border: none;
  cursor: pointer;
}

.product-slider__dot.is-active {
  background: #000;
}

{% endstylesheet %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const root = document.querySelector('[data-slider]');
  if (!root) return;

  const track = root.querySelector('.product-slider__track');
  const slides = root.querySelectorAll('.product-slider__slide');
  const prev = root.querySelector('.product-slider__arrow--prev');
  const next = root.querySelector('.product-slider__arrow--next');
  const dotsWrap = root.querySelector('.product-slider__dots');

  let index = 0;

  function getSlideWidth() {
    return slides[0].offsetWidth + 10; // include gap
  }

  function goToSlide(i) {
    index = i;
    track.scrollTo({
      left: getSlideWidth() * index,
      behavior: 'smooth'
    });
    updateDots();
  }

  // Buttons
  next.addEventListener('click', () => {
    if (index < slides.length - 1) {
      goToSlide(index + 1);
    }
  });

  prev.addEventListener('click', () => {
    if (index > 0) {
      goToSlide(index - 1);
    }
  });

  // Dots
  slides.forEach((_, i) => {
    const dot = document.createElement('button');
    dot.className = 'product-slider__dot';
    dot.addEventListener('click', () => goToSlide(i));
    dotsWrap.appendChild(dot);
  });

  function updateDots() {
    const dots = dotsWrap.querySelectorAll('.product-slider__dot');
    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
    });
  }

  updateDots();
});
</script>