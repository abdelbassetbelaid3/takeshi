<div class="product-slider" data-slider>

  <div class="product-slider__track">

    {% for image in product.images %}
      <div class="product-slider__slide">
        {% render 'image', class: 'product-image', image: image %}
      </div>
    {% endfor %}

  </div>

  <button class="product-slider__arrow product-slider__arrow--prev"
          aria-label="Previous image">‹</button>

  <button class="product-slider__arrow product-slider__arrow--next"
          aria-label="Next image">›</button>

  <div class="product-slider__dots"
       role="tablist"
       aria-label="Image pagination"></div>

</div>
{% stylesheet %}

/* =========================
   SLIDER BASE
========================= */

.product-slider {
  position: relative;
  max-width: 100%;
  overflow: hidden;
  margin: auto;
}

.product-slider__track {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.product-slider__track::-webkit-scrollbar {
  display: none;
}

/* DEFAULT (mobile) */
.product-slider__slide {
  flex: 0 0 100%;
  scroll-snap-align: center;
}

/* =========================
   TABLET (2 SLIDES)
========================= */
@media (min-width: 768px) {
  .product-slider__slide {
    flex: 0 0 50%;
  }
}

/* =========================
   DESKTOP (3 PORTRAIT MODE)
========================= */
@media (min-width: 1024px) {
  .product-slider__slide {
    flex: 0 0 33.333%;
  }
}

/* IMAGE */
.product-image img {
  width: 100%;
  height: 650px;
  object-fit: cover;
  display: block;
}

/* =========================
   ARROWS
========================= */

.product-slider__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: rgba(0,0,0,0.5);
  color: #fff;
  cursor: pointer;
  z-index: 10;
}

.product-slider__arrow--prev { left: 10px; }
.product-slider__arrow--next { right: 10px; }

/* =========================
   DOTS
========================= */

.product-slider__dots {
  position: absolute;
  bottom: 10px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 6px;
}

.product-slider__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: #ccc;
  cursor: pointer;
}

.product-slider__dot.is-active {
  background: #000;
}

{% endstylesheet %}
<script>
document.addEventListener("DOMContentLoaded", () => {

  const root = document.querySelector("[data-slider]");
  if (!root) return;

  const track = root.querySelector(".product-slider__track");
  const slides = Array.from(root.querySelectorAll(".product-slider__slide"));
  const prev = root.querySelector(".product-slider__arrow--prev");
  const next = root.querySelector(".product-slider__arrow--next");
  const dotsWrap = root.querySelector(".product-slider__dots");

  let index = 0;
  let isAnimating = false;

  const getStep = () => slides[0].offsetWidth + 10;

  /* =========================
     CLONE FIRST & LAST (INFINITE LOOP)
  ========================= */

  const firstClone = slides[0].cloneNode(true);
  const lastClone = slides[slides.length - 1].cloneNode(true);

  firstClone.classList.add("is-clone");
  lastClone.classList.add("is-clone");

  track.appendChild(firstClone);
  track.insertBefore(lastClone, slides[0]);

  const allSlides = track.querySelectorAll(".product-slider__slide");

  // Start at first real slide (skip cloned last)
  let currentIndex = 1;

  track.scrollTo({
    left: getStep() * currentIndex,
    behavior: "auto"
  });

  /* =========================
     MOVE FUNCTION
  ========================= */

  function goTo(i) {
    if (isAnimating) return;
    isAnimating = true;

    currentIndex = i;

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "smooth"
    });

    setTimeout(() => {
      handleLoopEdges();
      updateDots();
      isAnimating = false;
    }, 300);
  }

  /* =========================
     LOOP FIX (JUMP WITHOUT USER SEEING)
  ========================= */

  function handleLoopEdges() {

    // jumped to last clone → reset to real last
    if (currentIndex === allSlides.length - 1) {
      currentIndex = 1;
      track.scrollTo({
        left: getStep() * currentIndex,
        behavior: "none"
      });
    }

    // jumped to first clone → reset to real first
    if (currentIndex === 0) {
      currentIndex = allSlides.length - 2;
      track.scrollTo({
        left: getStep() * currentIndex,
        behavior: "none"
      });
    }

  }

  /* =========================
     NAVIGATION
  ========================= */

  next.addEventListener("click", () => {
    goTo(currentIndex + 1);
  });

  prev.addEventListener("click", () => {
    goTo(currentIndex - 1);
  });

  /* =========================
     DOTS (ignore clones)
  ========================= */

  const realSlidesCount = slides.length;

  for (let i = 0; i < realSlidesCount; i++) {
    const dot = document.createElement("button");
    dot.className = "product-slider__dot";
    dot.addEventListener("click", () => goTo(i + 1));
    dotsWrap.appendChild(dot);
  }

  function updateDots() {
    const dots = dotsWrap.querySelectorAll(".product-slider__dot");

    let realIndex = currentIndex - 1;

    if (realIndex < 0) realIndex = realSlidesCount - 1;
    if (realIndex >= realSlidesCount) realIndex = 0;

    dots.forEach((dot, i) => {
      dot.classList.toggle("is-active", i === realIndex);
    });
  }

  updateDots();

});
</script>