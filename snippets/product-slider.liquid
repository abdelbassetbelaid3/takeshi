<div class="product-slider" data-slider {{ section.shopify_attributes }}>

  <!-- TRACK -->
  <div class="product-slider__track">

    {% for image in product.images %}

      <div class="product-slider__slide">

        <div class="product-slider__image-wrap">

          {% render 'image',
            class: 'product-slider__image',
            image: image
          %}

        </div>

      </div>

    {% endfor %}

  </div>

  <!-- PREV -->
  <button
    class="product-slider__arrow product-slider__arrow--prev"
    aria-label="Previous image"
  >
    &#10094;
  </button>

  <!-- NEXT -->
  <button
    class="product-slider__arrow product-slider__arrow--next"
    aria-label="Next image"
  >
    &#10095;
  </button>

  <!-- DOTS -->
  <div
    class="product-slider__dots"
    role="tablist"
    aria-label="Image pagination"
  ></div>

</div>

{% stylesheet %}

/* =========================
   WRAPPER
========================= */

.product-slider{
  position: relative;
  width: 100%;
  overflow: hidden;

  background: #fff;

  padding: 14px 0 55px;
}

/* =========================
   TRACK
========================= */

.product-slider__track{
  display: flex;
  align-items: stretch;
  gap: 10px;

  overflow-x: auto;

  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;

  scrollbar-width: none;

  padding: 0 6px;
}

.product-slider__track::-webkit-scrollbar{
  display: none;
}

/* =========================
   SLIDES
========================= */

/* MOBILE */

.product-slider__slide{
  flex: 0 0 100%;
  scroll-snap-align: center;
}

/* TABLET */

@media(min-width:768px){

  .product-slider__slide{
    flex: 0 0 calc(50% - 5px);
  }

}

/* DESKTOP */

@media(min-width:1024px){

  .product-slider__slide{
    flex: 0 0 calc(33.333% - 8px);
  }

}

/* =========================
   IMAGE WRAP
========================= */

.product-slider__image-wrap{
  position: relative;
  overflow: hidden;

  width: 100%;
  height: 100%;

  aspect-ratio: 2 / 3;

  background: #ececec;
}

/* =========================
   IMAGE
========================= */

.product-slider__image{
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;
}

.product-slider__image img{
  width: 100%;
  height: 100%;

  object-fit: cover;
  display: block;

  transition: transform .7s ease;
}

/* HOVER */

.product-slider__slide:hover
.product-slider__image img{
  transform: scale(1.04);
}

/* =========================
   ARROWS
========================= */

.product-slider__arrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;

  width: 52px;
  height: 52px;

  border: none;
  border-radius: 999px;

  background: rgba(255,255,255,.92);

  color: #111;
  font-size: 24px;

  cursor: pointer;

  transition: .3s ease;

  backdrop-filter: blur(6px);

  box-shadow: 0 4px 20px rgba(0,0,0,.08);
}

.product-slider__arrow:hover{
  background: #111;
  color: #fff;
}

.product-slider__arrow--prev{
  left: 16px;
}

.product-slider__arrow--next{
  right: 16px;
}

/* =========================
   DOTS
========================= */

.product-slider__dots{
  position: absolute;

  left: 50%;
  bottom: 18px;

  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 8px;
}

.product-slider__dot{
  width: 7px;
  height: 7px;

  border-radius: 999px;
  border: none;

  background: #bbb;

  cursor: pointer;

  transition: .3s ease;
}

.product-slider__dot.is-active{
  background: #111;
  transform: scale(1.2);
}

/* =========================
   MOBILE
========================= */

@media(max-width:767px){

  .product-slider{
    padding-bottom: 45px;
  }

  .product-slider__track{
    gap: 8px;
  }

  .product-slider__slide{
    flex: 0 0 85%;
  }

  .product-slider__arrow{
    width: 42px;
    height: 42px;

    font-size: 18px;
  }

  .product-slider__arrow--prev{
    left: 8px;
  }

  .product-slider__arrow--next{
    right: 8px;
  }

}

{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", () => {

  const root =
    document.querySelector("[data-slider]");

  if(!root) return;

  const track =
    root.querySelector(".product-slider__track");

  const prev =
    root.querySelector(".product-slider__arrow--prev");

  const next =
    root.querySelector(".product-slider__arrow--next");

  const dotsWrap =
    root.querySelector(".product-slider__dots");

  let isAnimating = false;

  /*
  =========================
  ORIGINAL SLIDES
  =========================
  */

  const originalSlides =
    Array.from(
      track.querySelectorAll(".product-slider__slide")
    );

  if(originalSlides.length <= 1) return;

  /*
  =========================
  CREATE CLONES
  =========================
  */

  const firstClone =
    originalSlides[0].cloneNode(true);

  const secondClone =
    originalSlides[1]
      ? originalSlides[1].cloneNode(true)
      : originalSlides[0].cloneNode(true);

  const lastClone =
    originalSlides[
      originalSlides.length - 1
    ].cloneNode(true);

  const beforeLastClone =
    originalSlides[
      originalSlides.length - 2
    ]
      ? originalSlides[
          originalSlides.length - 2
        ].cloneNode(true)
      : originalSlides[
          originalSlides.length - 1
        ].cloneNode(true);

  firstClone.classList.add("is-clone");
  secondClone.classList.add("is-clone");
  lastClone.classList.add("is-clone");
  beforeLastClone.classList.add("is-clone");

  track.appendChild(firstClone);
  track.appendChild(secondClone);

  track.insertBefore(
    beforeLastClone,
    originalSlides[0]
  );

  track.insertBefore(
    lastClone,
    originalSlides[0]
  );

  /*
  =========================
  ALL SLIDES
  =========================
  */

  const getSlides = () =>
    Array.from(
      track.querySelectorAll(".product-slider__slide")
    );

  let currentIndex = 2;

  /*
  =========================
  STEP
  =========================
  */

  function getStep(){

    const slide = getSlides()[0];

    const styles =
      window.getComputedStyle(track);

    const gap =
      parseFloat(styles.columnGap || styles.gap || 0);

    return slide.getBoundingClientRect().width + gap;

  }

  /*
  =========================
  INIT
  =========================
  */

  function init(){

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "auto"
    });

  }

  init();

  /*
  =========================
  GO TO
  =========================
  */

  function goTo(index){

    if(isAnimating) return;

    isAnimating = true;

    currentIndex = index;

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "smooth"
    });

    updateDots();

    setTimeout(() => {

      fixInfiniteLoop();

      isAnimating = false;

    }, 500);

  }

  /*
  =========================
  INFINITE LOOP
  =========================
  */

  function fixInfiniteLoop(){

    const slides = getSlides();

    if(currentIndex >= slides.length - 2){

      currentIndex = 2;

      track.scrollTo({
        left: getStep() * currentIndex,
        behavior: "auto"
      });

    }

    if(currentIndex <= 1){

      currentIndex =
        slides.length - 4;

      track.scrollTo({
        left: getStep() * currentIndex,
        behavior: "auto"
      });

    }

  }

  /*
  =========================
  NEXT
  =========================
  */

  next.addEventListener("click", () => {

    goTo(currentIndex + 1);

  });

  /*
  =========================
  PREV
  =========================
  */

  prev.addEventListener("click", () => {

    goTo(currentIndex - 1);

  });

  /*
  =========================
  DOTS
  =========================
  */

  originalSlides.forEach((_, index) => {

    const dot =
      document.createElement("button");

    dot.className =
      "product-slider__dot";

    dot.addEventListener("click", () => {

      goTo(index + 2);

    });

    dotsWrap.appendChild(dot);

  });

  function updateDots(){

    const dots =
      dotsWrap.querySelectorAll(".product-slider__dot");

    let realIndex =
      currentIndex - 2;

    if(realIndex < 0){
      realIndex =
        originalSlides.length - 1;
    }

    if(realIndex >= originalSlides.length){
      realIndex = 0;
    }

    dots.forEach((dot, index) => {

      dot.classList.toggle(
        "is-active",
        index === realIndex
      );

    });

  }

  updateDots();

  /*
  =========================
  AUTOPLAY
  =========================
  */

  let autoPlay =
    setInterval(() => {

      goTo(currentIndex + 1);

    }, 4000);

  function resetAuto(){

    clearInterval(autoPlay);

    autoPlay =
      setInterval(() => {

        goTo(currentIndex + 1);

      }, 4000);

  }

  next.addEventListener("click", resetAuto);
  prev.addEventListener("click", resetAuto);

  /*
  =========================
  TOUCH SWIPE
  =========================
  */

  let startX = 0;
  let endX = 0;

  root.addEventListener("touchstart", (e) => {

    startX = e.touches[0].clientX;

  });

  root.addEventListener("touchmove", (e) => {

    endX = e.touches[0].clientX;

  });

  root.addEventListener("touchend", () => {

    const diff = startX - endX;

    if(diff > 50){

      goTo(currentIndex + 1);

    }

    if(diff < -50){

      goTo(currentIndex - 1);

    }

    resetAuto();

  });

  /*
  =========================
  RESIZE
  =========================
  */

  window.addEventListener("resize", () => {

    track.scrollTo({
      left: getStep() * currentIndex,
      behavior: "auto"
    });

  });

});
</script>

{% schema %}
{
  "name": "Product slider",
  "presets": [
    {
      "name": "Product slider"
    }
  ]
}
{% endschema %}