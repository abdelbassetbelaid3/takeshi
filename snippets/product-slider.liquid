<div class="product-slider" data-slider>

  <div class="product-slider__track">

    {% for image in product.images %}
      <div class="product-slider__slide">
        {% render 'image', class: 'product-image', image: image %}
      </div>
    {% endfor %}

  </div>

  <button class="product-slider__arrow product-slider__arrow--prev"
          aria-label="Previous image">‹</button>

  <button class="product-slider__arrow product-slider__arrow--next"
          aria-label="Next image">›</button>

  <div class="product-slider__dots"
       role="tablist"
       aria-label="Image pagination"></div>

</div>

{% stylesheet %}

/* =========================
   SLIDER BASE
========================= */

.product-slider {
  position: relative;
  max-width: 100%;
  overflow: hidden;
  margin: auto;
}

.product-slider__track {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.product-slider__track::-webkit-scrollbar {
  display: none;
}

/* DEFAULT (mobile) */
.product-slider__slide {
  flex: 0 0 100%;
  scroll-snap-align: center;
}

/* =========================
   TABLET (2 SLIDES)
========================= */
@media (min-width: 768px) {
  .product-slider__slide {
    flex: 0 0 50%;
  }
}

/* =========================
   DESKTOP (3 PORTRAIT MODE)
========================= */
@media (min-width: 1024px) {
  .product-slider__slide {
    flex: 0 0 33.333%;
  }
}

/* IMAGE */
.product-image img {
  width: 100%;
  height: 650px;
  object-fit: cover;
  display: block;
}

/* =========================
   ARROWS
========================= */

.product-slider__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: rgba(0,0,0,0.5);
  color: #fff;
  cursor: pointer;
  z-index: 10;
}

.product-slider__arrow--prev { left: 10px; }
.product-slider__arrow--next { right: 10px; }

/* =========================
   DOTS
========================= */

.product-slider__dots {
  position: absolute;
  bottom: 10px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 6px;
}

.product-slider__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: #ccc;
  cursor: pointer;
}

.product-slider__dot.is-active {
  background: #000;
}

{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", () => {

  const root = document.querySelector("[data-slider]");
  if (!root) return;

  const track = root.querySelector(".product-slider__track");
  const slides = root.querySelectorAll(".product-slider__slide");
  const prev = root.querySelector(".product-slider__arrow--prev");
  const next = root.querySelector(".product-slider__arrow--next");
  const dotsWrap = root.querySelector(".product-slider__dots");

  let index = 0;

  const getWidth = () => slides[0].offsetWidth + 10;

  function goTo(i) {
    index = i;
    track.scrollTo({
      left: getWidth() * index,
      behavior: "smooth"
    });
    updateDots();
  }

  next.addEventListener("click", () => {
    if (index < slides.length - 1) goTo(index + 1);
  });

  prev.addEventListener("click", () => {
    if (index > 0) goTo(index - 1);
  });

  slides.forEach((_, i) => {
    const dot = document.createElement("button");
    dot.className = "product-slider__dot";
    dot.addEventListener("click", () => goTo(i));
    dotsWrap.appendChild(dot);
  });

  function updateDots() {
    dotsWrap.querySelectorAll(".product-slider__dot")
      .forEach((dot, i) => {
        dot.classList.toggle("is-active", i === index);
      });
  }

  updateDots();

});
</script>